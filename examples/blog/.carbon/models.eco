/**
 * A column holding a `Status`, compared and assigned with its cases.
 */
public struct StatusColumn
{
    /**
     * The column as hydrahon sees it, for anything else that takes a term.
     */
    public hydrahon::Term<int64> $term;

    /**
     * The condition that the column holds `$case`. The same as `==`, and the spelling to use
     * inside `&&` and `||`, where an operator of a generated type is not picked.
     */
    public const function is(blog::Status $case) : hydrahon::Term<bool>
    {
        int64 $raw = $case->value() as int64;
        return $this->term == $raw;
    }

    /**
     * The condition that the column holds any of `$cases`.
     */
    public const function in(const array<blog::Status>& $cases) : hydrahon::Term<bool>
    {
        array<int64> $raw = [];
        foreach ($cases as const &$v) {
            $raw[] = $v->value() as int64;
        }
        return $this->term in $raw;
    }

    /**
     * Ascending order on the column's stored value: `->order([PostTable::$status->asc()])`.
     */
    public const function asc() : hydrahon::Order
    {
        return $this->term->asc();
    }

    /**
     * Descending order on the column's stored value.
     */
    public const function desc() : hydrahon::Order
    {
        return $this->term->desc();
    }
}

operator (StatusColumn $column) == (blog::Status $case) : hydrahon::Term<bool>
{
    return $column->is($case);
}

operator (StatusColumn $column) != (blog::Status $case) : hydrahon::Term<bool>
{
    int64 $raw = $case->value() as int64;
    return $column->term != $raw;
}

operator (hydrahon::Values& $into)[const StatusColumn& $column] = (blog::Status $case) : void
{
    int64 $raw = $case->value() as int64;
    $into[$column->term] = $raw;
}

/**
 * The wiring of the models of this namespace, registered and checked in one go.
 */
public struct Carbon
{
    /**
     * The migrations of this namespace in id order, for a carbon::Migrator.
     */
    public static function migrations() : array<carbon::migrate::Step>
    {
        array<carbon::migrate::Step> $out = [
            carbon::migrate::Step('20261029120000_create_users', blog::CreateUsers(), true),
            carbon::migrate::Step('20261029120100_create_posts', blog::CreatePosts(), true),
            carbon::migrate::Step('20261029120200_create_comments', blog::CreateComments(), true),
        ];
        return $out;
    }

    /**
     * Register the repositories carbongen wrote for these models; the ones the module declares
     * are registered by the app, with what they need.
     */
    public static function register(carbon::DB $db) : status<carbon::Error>
    {
        return .ok();
    }

    /**
     * Whether every repository these models need is registered on `$db`: their own, and the
     * ones their relations load through. Run it once after registering, so a repository left
     * out stops the app at startup, not on the first request that reaches it; the error names
     * every one left out. It also makes the store of every model, so none is made while
     * requests run.
     */
    public static function check(carbon::DB $db) : status<carbon::Error>
    {
        array<string> $missing = [];
        if (!$db->has<blog::CommentRepository>()) {
            $missing[] = 'blog::CommentRepository';
        }
        if (!$db->has<blog::PostRepository>()) {
            $missing[] = 'blog::PostRepository';
        }
        if (!$db->has<blog::UserRepository>()) {
            $missing[] = 'blog::UserRepository';
        }
        if ($missing->count() > 0) {
            return .error(.unregistered(str::join($missing, ', ')));
        }
        $db->store<blog::Comment, int64, blog::CommentTable>();
        $db->store<blog::Post, int64, blog::PostTable>();
        $db->store<blog::User, int64, blog::UserTable>();
        return .ok();
    }
}
