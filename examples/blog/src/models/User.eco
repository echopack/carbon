namespace blog;

#[carbon::model: 'users']
public class User : carbon::Model<User, UserRepository>
{
    public carbon::Link<UserRepository> $link = .detached();

    #[carbon::key]
    public int64 $id = 0;
    public string $email;
    public string $name;
    public bool $admin = false;

    #[carbon::created]
    public hydrahon::DateTime? $createdAt = null;

    #[carbon::updated]
    public hydrahon::DateTime? $updatedAt = null;

    #[carbon::hasMany: 'authorId']
    public carbon::Many<Post> $posts = .unloaded();

    public function link() : carbon::Link<UserRepository>&
    {
        return $this->link;
    }
}
