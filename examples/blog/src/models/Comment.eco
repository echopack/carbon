namespace blog;

#[carbon::model: 'comments']
public class Comment : carbon::Model<Comment, CommentRepository>
{
    public carbon::Link<CommentRepository> $link = .detached();

    #[carbon::key]
    public int64 $id = 0;
    public int64 $postId;
    public string $body;

    #[carbon::created]
    public hydrahon::DateTime? $createdAt = null;

    #[carbon::belongsTo: 'postId']
    public carbon::One<Post> $post = .unloaded();

    public function link() : carbon::Link<CommentRepository>&
    {
        return $this->link;
    }
}
