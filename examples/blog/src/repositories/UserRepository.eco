namespace blog;

public struct UserRepository : carbon::Repository<User, UserQuery, int64>, UserWiring
{
    public carbon::Session $session;

    /**
     * The user with this email, null when there is none.
     */
    public function byEmail(const string& $email) : result<User?, carbon::Error>
    {
        return $this->get(UserTable::$email == $email);
    }
}
