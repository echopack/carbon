namespace blog;

public struct CommentRepository : carbon::Repository<Comment, CommentQuery, int64>, CommentWiring
{
    public carbon::Session $session;

    /**
     * Leave a comment on `$post`.
     */
    public function leave(const Post& $post, const string& $body) : result<Comment, carbon::Error>
    {
        return $this->create(Comment($postId: $post->id, $body: $body));
    }
}
