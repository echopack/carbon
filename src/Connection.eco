namespace carbon;

use std::time;
use carbon::listen::Ran;

/**
 * One session's way to the database: the connection it opened from the `DB`'s source, its open
 * transaction and how to undo what that transaction wrote into models. Every session has its
 * own, so a transaction, and what its rollback puts back, is that session's alone. It opens its
 * connection with the first statement it runs and lets go of it with the session. The clock,
 * the listeners and the names of other databases are the `DB`'s, shared by every session.
 * Nothing in carbon is global.
 */
public class Connection
{
    public calendar::Clock $clock;
    internal Engine $engine;

    /**
     * The connection this session runs on, null until its first statement opens one.
     */
    internal Driver? $driver = null;
    internal bool $open = false;

    /**
     * How to put back every model a write of the open transaction changed, in the order the
     * writes ran. A rollback runs it backwards; a commit forgets it.
     */
    internal array<function<void()>> $undo = [];

    /**
     * A connection of its own on `$driver`, outside any `DB`.
     */
    public constructor(Driver $driver, clock: calendar::Clock $clock = calendar::SystemClock())
    {
        $this->engine = Engine(Single($driver), $clock);
        $this->clock = $clock;
    }

    internal constructor(Engine $engine)
    {
        $this->engine = $engine;
        $this->clock = $engine->clock;
    }

    /**
     * What the clock says, to the second: the instant a DATETIME column without fractional
     * seconds gives back, and what created, updated and deleted columns are stamped with.
     */
    public const function now() : time::timestamp
    {
        return Temporal::second($this->clock->now());
    }

    /**
     * Name the databases (schemas) the app reaches besides the connection's own, so a query can
     * join a table there without knowing where it is deployed:
     * `$db->schema('cache', 'movies_cache_prod')`, then
     * `MovieCountsTable::alias('c', schema: $q->connection()->schema('cache'))`. The names are
     * the `DB`'s: every session sees them.
     */
    public function schema(const string& $name, const string& $actual) : void
    {
        $this->engine->seal->refuse('naming a schema');
        $this->engine->schemas[$name] = $actual;
    }

    /**
     * The database named `$name`, null when none was given.
     */
    public const function schema(const string& $name) : string?
    {
        if (!$this->engine->schemas->has($name)) {
            return null;
        }
        string $actual = $this->engine->schemas->get($name);
        return $actual;
    }

    /**
     * Tell `$listener` about every statement of every session from now on.
     */
    public function listen(Listener $listener) : void
    {
        $this->engine->seal->refuse('adding a listener');
        $this->engine->listeners[] = $listener;
    }

    /**
     * What the source's connections can do.
     */
    public const function traits() : Traits
    {
        return $this->engine->source->traits();
    }

    /**
     * Run a SELECT.
     */
    public function query(const hydrahon::Select& $q) : result<Cursor, Error>
    {
        Driver $d = guard $this->lease() else ($e) { return .error($e); }
        return $this->fetch($d, $d->render($q));
    }

    /**
     * Run an INSERT with RETURNING.
     */
    public function query(const hydrahon::Insert& $q) : result<Cursor, Error>
    {
        Driver $d = guard $this->lease() else ($e) { return .error($e); }
        return $this->fetch($d, $d->render($q));
    }

    public function exec(const hydrahon::Insert& $q) : result<Written, Error>
    {
        Driver $d = guard $this->lease() else ($e) { return .error($e); }
        return $this->write($d, $d->render($q));
    }

    public function exec(const hydrahon::Update& $q) : result<Written, Error>
    {
        Driver $d = guard $this->lease() else ($e) { return .error($e); }
        return $this->write($d, $d->render($q));
    }

    public function exec(const hydrahon::Delete& $q) : result<Written, Error>
    {
        Driver $d = guard $this->lease() else ($e) { return .error($e); }
        return $this->write($d, $d->render($q));
    }

    /**
     * Run `$work` in a transaction: commit when it succeeds, roll back when it fails and hand
     * back its error. Transactions do not nest.
     */
    public function transaction(function<status<Error>()> $work) : status<Error>
    {
        guard $this->begin() else ($e) { return .error($e); }
        status<Error> $done = $work();
        if ($done->failed()) {
            // the work's error is the one worth reporting, not a failed rollback
            $this->close(false);
            return $done;
        }
        return $this->close(true);
    }

    /**
     * Run `$work` in a transaction and hand back what it made: committed when it succeeds,
     * rolled back when it fails.
     *
     * ```echo
     * User $carol = guard $session->transaction(function[$users, $posts]() : result<User, carbon::Error> {
     *     User $u = guard $users->create(User($email: 'carol@example.com', $name: 'Carol')) else ($e) { return .error($e); }
     *     guard $posts->create(Post($authorId: $u->id, $title: 'Hello')) else ($e) { return .error($e); }
     *     return .ok($u);
     * });
     * ```
     */
    public function transaction<T>(function<result<T, Error>()> $work) : result<T, Error>
    {
        return $this->produce<T>($work);
    }

    /**
     * `transaction<T>` under a name of its own, so a generic caller reaches it: from a generic
     * body, a call to `transaction` resolves to the overload that is not generic.
     */
    internal function produce<T>(function<result<T, Error>()> $work) : result<T, Error>
    {
        guard $this->begin() else ($e) { return .error($e); }
        result<T, Error> $done = $work();
        if ($done->failed()) {
            $this->close(false);
            return $done;
        }
        guard $this->close(true) else ($e) { return .error($e); }
        return $done;
    }

    /**
     * Run `$sql` as it is, without parameters: DDL, migrations, anything carbon does not build.
     * Listeners hear it like every other statement.
     */
    public function run(const string& $sql) : result<Written, Error>
    {
        Driver $d = guard $this->lease() else ($e) { return .error($e); }
        return $this->write($d, Statement(plain: $sql));
    }

    /**
     * Run `$sql` as it is, without parameters, for the rows it answers with.
     */
    internal function ask(const string& $sql) : result<Cursor, Error>
    {
        Driver $d = guard $this->lease() else ($e) { return .error($e); }
        return $this->fetch($d, Statement(plain: $sql));
    }

    /**
     * Whether a transaction is open.
     */
    public const function inTransaction() : bool
    {
        return $this->open;
    }

    /**
     * The connection, opened from the source the first time it is needed and kept from then on.
     */
    internal function lease() : result<Driver, Error>
    {
        // bound first: a value compared with null where it is made is never let go of
        Driver? $held = $this->driver;
        if ($held != null) {
            Driver $d = guard $held;
            return .ok($d);
        }
        Driver $d = guard $this->engine->source->open() else ($e) { return .error($e); }
        $this->driver = $d;
        return .ok($d);
    }

    internal function begin() : status<Error>
    {
        if ($this->open) {
            return .error(.nested);
        }
        guard $this->control(.begin) else ($e) { return .error($e); }
        $this->open = true;
        return .ok();
    }

    /**
     * Close the open transaction, committing it or rolling it back. Whatever the database does
     * not keep, the models do not keep either: a rollback, or a commit that failed, puts every
     * model the transaction wrote back the way it was before.
     */
    internal function close(bool $commit) : status<Error>
    {
        $this->open = false;
        if ($commit) {
            status<Error> $done = $this->control(.commit);
            if ($done->failed()) {
                $this->revert();
            } else {
                $this->undo = [];
            }
            return $done;
        }
        $this->revert();
        return $this->control(.rollback);
    }

    /**
     * Keep `$step` to run if the open transaction rolls back. Outside a transaction a write
     * stands on its own, and nothing is kept.
     */
    internal function journal(function<void()> $step) : void
    {
        if ($this->open) {
            $this->undo[] = $step;
        }
    }

    /**
     * Run the undo steps backwards and forget them.
     */
    internal function revert() : void
    {
        usize $i = $this->undo->count();
        while ($i > 0) {
            $i = $i - 1;
            function<void()> $step = $this->undo[$i];
            $step();
        }
        $this->undo = [];
    }

    internal function fetch(Driver $d, result<hydrahon::Sql, hydrahon::Error> $rendered) : result<Cursor, Error>
    {
        hydrahon::Sql $sql = guard $rendered else ($e) { return .error(.render($e)); }
        return $this->fetch($d, Statement($sql));
    }

    internal function write(Driver $d, result<hydrahon::Sql, hydrahon::Error> $rendered) : result<Written, Error>
    {
        hydrahon::Sql $sql = guard $rendered else ($e) { return .error(.render($e)); }
        return $this->write($d, Statement($sql));
    }

    internal function fetch(Driver $d, const Statement& $s) : result<Cursor, Error>
    {
        time::instant $start = time::instant::now();
        result<Cursor, Error> $r = $d->query($s);
        $this->tell($s, $start, $r->failed());
        return $r;
    }

    internal function write(Driver $d, const Statement& $s) : result<Written, Error>
    {
        time::instant $start = time::instant::now();
        result<Written, Error> $r = $d->exec($s);
        $this->tell($s, $start, $r->failed());
        return $r;
    }

    internal function control(Control $step) : status<Error>
    {
        Driver $d = guard $this->lease() else ($e) { return .error($e); }
        time::instant $start = time::instant::now();
        status<Error> $r = match ($step) {
            Control::begin => $d->begin(),
            Control::commit => $d->commit(),
            Control::rollback => $d->rollback(),
        };
        $this->tell($step->statement(), $start, $r->failed());
        return $r;
    }

    internal function tell(const Statement& $s, time::instant $start, bool $failed) : void
    {
        if ($this->engine->listeners->count() == 0) {
            return;
        }
        Ran $event = Ran($s, $start->elapsed(), $failed);
        foreach ($this->engine->listeners as &$l) {
            $l->ran($event);
        }
    }
}
