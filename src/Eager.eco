namespace carbon;

/**
 * A relation that can be loaded for a batch of models `M` at once: what `Query::with` takes.
 * carbongen writes one per relation slot, and the `with…()` methods of the generated
 * `PostRelations` build them: `->withAuthor()`.
 */
public interface Eager<M>
{
    /**
     * Fill the relation's slot of every model in `$models`, with one query in `$session`.
     * `$seen` holds what the load handed out so far; a relation reuses those models, and adds
     * the ones it reads.
     */
    function load(array<M>& $models, Session $session, Loaded $seen) : status<Error>;
}
