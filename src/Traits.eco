namespace carbon;

/**
 * What a driver can do that changes how carbon talks to it.
 */
public struct Traits
{
    /**
     * Keys of inserted rows come back through RETURNING (Postgres, SQLite) instead of the last
     * insert id (MySQL).
     */
    public bool $returning = false;

    /**
     * The affected count of an UPDATE is the rows it matched, not only the ones it changed. Only
     * then does a write by key that touched no row mean the row is gone or changed underneath,
     * and carbon answers it with `.stale`. MySQL counts matched rows once the connection asks for
     * it (`foundRows`); `carbon::mysql::Driver::open` does.
     */
    public bool $matched = false;
}
