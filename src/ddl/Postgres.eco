namespace carbon::ddl;

use carbon::Error;
use hydrahon::Value;

/**
 * PostgreSQL 10 or later. Identifiers are quoted the way hydrahon's Postgres dialect quotes them.
 * A literal with a backslash is written as an escape string (`E'...'`), so it reads the same
 * whatever `standard_conforming_strings` is set to.
 *
 * Postgres has no index inside `CREATE TABLE` and no unsigned integers: an index is a statement
 * of its own after the table, and an unsigned column is a signed one with `CHECK (col >= 0)`.
 * A TIME is an INTERVAL, which holds a negative duration and one past a day as MySQL's TIME
 * does. Schema changes take part in transactions, so a migration and its ledger row commit
 * together.
 */
public class Postgres : Grammar
{
    private hydrahon::Postgres $dialect = hydrahon::Postgres();

    public const function create(const Table& $table) : result<array<string>, Error>
    {
        if ($table->columns->count() == 0) {
            return .error(.invalid("table {$table->name} has no columns"));
        }
        array<string> $parts = [];
        foreach ($table->columns as const &$c) {
            string $col = guard $this->column($c) else ($e) {
                return .error($e);
            }
            $parts[] = mv $col;
        }
        if ($table->primary->count() > 0) {
            $parts[] = "PRIMARY KEY ({$this->list($table->primary)})";
        }
        foreach ($table->foreigns as const &$f) {
            $parts[] = $this->foreign($table->name, $f);
        }
        array<string> $all = [Literal::table($this->dialect, $table, $parts)];
        foreach ($table->indexes as const &$i) {
            $all[] = $this->index($table->name, $i, $table->missing);
        }
        return .ok($all);
    }

    /**
     * Changes to columns and constraints share one `ALTER TABLE`. An index is a statement of its
     * own, and so is a renamed column, since Postgres renames alone; the statements keep the
     * order of the changes. A column modified to count up gets a new identity in a statement of
     * its own after its type changed, and the identity is moved past the keys already there.
     */
    public const function alter(const Alter& $alter) : result<array<string>, Error>
    {
        if ($alter->changes->count() == 0) {
            return .error(.invalid("altering {$alter->table} changes nothing"));
        }
        string $table = $this->name($alter->table);
        array<string> $out = [];
        array<string> $parts = [];
        foreach ($alter->changes as const &$change) {
            match ($change) {
                Change::add($c) => {
                    string $col = guard $this->column($c) else ($e) {
                        return .error($e);
                    }
                    $parts[] = "ADD COLUMN {$col}";
                },
                Change::drop($name) => {
                    $parts[] = "DROP COLUMN {$this->name($name)}";
                },
                Change::rename($from, $to) => {
                    Postgres::flush($table, $parts, $out);
                    $out[] = "ALTER TABLE {$table} RENAME COLUMN {$this->name($from)} TO {$this->name($to)}";
                },
                Change::modify($c) => {
                    guard $this->modify($c, $parts) else ($e) {
                        return .error($e);
                    }
                    if ($c->increments) {
                        Postgres::flush($table, $parts, $out);
                        $out[] = "ALTER TABLE {$table} ALTER COLUMN {$this->name($c->name)} ADD GENERATED BY DEFAULT AS IDENTITY";
                        foreach ($this->advance($alter->table, $c->name) as $sql) {
                            $out[] = mv $sql;
                        }
                    }
                },
                Change::index($i) => {
                    Postgres::flush($table, $parts, $out);
                    $out[] = $this->index($alter->table, $i, false);
                },
                Change::dropIndex($name) => {
                    Postgres::flush($table, $parts, $out);
                    $out[] = "DROP INDEX {$this->name($name)}";
                },
                Change::foreign($f) => {
                    $parts[] = "ADD {$this->foreign($alter->table, $f)}";
                },
                Change::dropForeign($name) => {
                    $parts[] = "DROP CONSTRAINT {$this->name($name)}";
                },
            };
        }
        Postgres::flush($table, $parts, $out);
        return .ok($out);
    }

    public const function drop(const string& $table, bool $exists = false) : string
    {
        return Literal::drop($this->dialect, $table, $exists);
    }

    public const function rename(const string& $from, const string& $to) : string
    {
        return "ALTER TABLE {$this->name($from)} RENAME TO {$this->name($to)}";
    }

    /**
     * A session level advisory lock, tried every tenth of a second until `$seconds` have passed.
     * `pg_advisory_lock` would wait without end, and `lock_timeout` stops it with an error
     * rather than an answer, so the waiting is a recursive query that answers 1 or 0.
     */
    public const function lock(const string& $name, uint32 $seconds) : string
    {
        string $key = Postgres::key($name);
        uint64 $tries = ($seconds as uint64) * 10;
        string $out = 'WITH RECURSIVE attempt(n, got) AS (';
        $out->append("SELECT 0, pg_try_advisory_lock({$key}) UNION ALL ");
        $out->append("SELECT n + 1, pg_try_advisory_lock({$key}) FROM attempt ");
        $out->append("WHERE NOT got AND n < {$tries} AND pg_sleep(0.1) IS NOT NULL");
        $out->append(') SELECT got::int FROM attempt ORDER BY n DESC LIMIT 1');
        return $out;
    }

    public const function unlock(const string& $name) : string
    {
        string $key = Postgres::key($name);
        return "SELECT pg_advisory_unlock({$key})";
    }

    public const function transactional() : bool
    {
        return true;
    }

    /**
     * An identity takes no notice of a row inserted with a key of its own, unlike MySQL's
     * AUTO_INCREMENT, so after a seed the next key it counts would collide. This sets it to one
     * past the largest key, or to 1 for an empty table.
     *
     * A column without an identity or a sequence is an error rather than nothing done: `setval`
     * on the NULL `pg_get_serial_sequence` answers then would quietly move nothing.
     */
    public const function advance(const string& $table, const string& $column) : array<string>
    {
        string $quoted = $this->name($table);
        string $named = Postgres::literal($quoted);
        string $field = Postgres::literal($column);
        string $plain = Postgres::literal($table);
        string $col = $this->name($column);
        string $body = "DECLARE s text := pg_get_serial_sequence({$named}, {$field}); BEGIN ";
        $body->append("IF s IS NULL THEN RAISE EXCEPTION 'column %.% has no identity to advance', {$plain}, {$field}; END IF; ");
        $body->append("PERFORM setval(s, (SELECT COALESCE(MAX({$col}), 0) + 1 FROM {$quoted}), false); END");
        return [Postgres::block($body)];
    }

    /**
     * The column's definition: name, type, nullability, default and the rest.
     */
    private const function column(const Column& $c) : result<string, Error>
    {
        string $type = guard Postgres::type($c) else ($e) {
            return .error($e);
        }
        string $out = "{$this->name($c->name)} {$type}";
        if ($c->unsigned && !$c->kind->integer()) {
            return .error(.invalid("column {$c->name}: only a whole number can be unsigned"));
        }
        if ($c->nullable) {
            $out->append(' NULL');
        } else {
            $out->append(' NOT NULL');
        }
        guard Postgres::counts($c) else ($e) {
            return .error($e);
        }
        if ($c->increments) {
            $out->append(' GENERATED BY DEFAULT AS IDENTITY');
        }
        hydrahon::Value? $given = $c->default;
        if ($given != null) {
            hydrahon::Value $v = guard $given;
            string $literal = Postgres::value($v);
            $out->append(" DEFAULT {$literal}");
        }
        if ($c->primary) {
            $out->append(' PRIMARY KEY');
        }
        if ($c->unique) {
            $out->append(' UNIQUE');
        }
        if ($c->unsigned) {
            $out->append(" CHECK ({$this->name($c->name)} >= 0)");
        }
        return .ok($out);
    }

    /**
     * The clauses that bring a column to `$c`: its type, its nullability, its default and its
     * identity. What a column holds besides those (a key, an index, a check) is not changed
     * this way.
     *
     * `$c` is the whole new definition, as with MySQL's MODIFY COLUMN: a column that should go
     * on counting up says so with `increments`, and one that does not loses its identity.
     *
     * The identity and the default are dropped first, before the type changes: Postgres would
     * cast the old default to the new type, and an identity refuses a dropped default. A column
     * that counts up gets its identity back in `alter`, once the type has changed. How the old
     * values are cast is `using`'s.
     */
    private const function modify(const Column& $c, array<string>& $parts) : status<Error>
    {
        if ($c->primary || $c->unique || $c->unsigned) {
            return .error(.invalid("column {$c->name}: Postgres changes only the type, NULL, default and identity of a column; add a key, an index or a check as a change of its own"));
        }
        string $type = guard Postgres::type($c) else ($e) {
            return .error($e);
        }
        guard Postgres::counts($c) else ($e) {
            return .error($e);
        }
        string $col = $this->name($c->name);
        $parts[] = "ALTER COLUMN {$col} DROP IDENTITY IF EXISTS";
        $parts[] = "ALTER COLUMN {$col} DROP DEFAULT";
        string $using = Postgres::using($col, $c->kind, $type);
        $parts[] = "ALTER COLUMN {$col} TYPE {$type}{$using}";
        if ($c->nullable) {
            $parts[] = "ALTER COLUMN {$col} DROP NOT NULL";
        } else {
            $parts[] = "ALTER COLUMN {$col} SET NOT NULL";
        }
        hydrahon::Value? $given = $c->default;
        if ($given != null) {
            hydrahon::Value $v = guard $given;
            string $literal = Postgres::value($v);
            $parts[] = "ALTER COLUMN {$col} SET DEFAULT {$literal}";
        }
        return .ok();
    }

    /**
     * Refuse a column that counts up but cannot: one that is not a whole number, or one that
     * takes NULL or a default.
     */
    private static function counts(const Column& $c) : status<Error>
    {
        if (!$c->increments) {
            return .ok();
        }
        if (!$c->kind->integer()) {
            return .error(.invalid("column {$c->name}: only a whole number can count up"));
        }
        if ($c->nullable || $c->default != null) {
            return .error(.invalid("column {$c->name}: a column that counts up takes no NULL and no default"));
        }
        return .ok();
    }

    /**
     * How the old values of `$col`, already quoted, become `$type` in `ALTER COLUMN ... TYPE`,
     * empty for no USING at all.
     *
     * A whole number and a boolean go through their text: Postgres casts neither a SMALLINT nor a
     * BIGINT to a boolean or back, and the old type is not known here. A number becomes true
     * when it is not 0, and true and false become 1 and 0. A VARCHAR has no USING: an explicit
     * cast cuts a string that is too long, where the cast an assignment makes refuses it.
     */
    private static function using(const string& $col, const Kind& $kind, const string& $type) : string
    {
        if ($kind->integer()) {
            return " USING (CASE {$col}::text WHEN 'true' THEN 1 WHEN 'false' THEN 0 ELSE {$col}::text::numeric END)::{$type}";
        }
        return match ($kind) {
            Kind::bool => " USING CASE WHEN {$col}::text ~ '^-?[0-9.]+$' THEN {$col}::text::numeric <> 0 ELSE {$col}::text::boolean END",
            Kind::string($size) => '',
            else => " USING {$col}::{$type}",
        };
    }

    /**
     * `$body` as an anonymous PL/pgSQL block, between dollar quotes with a tag `$body` does not
     * hold, so no name in it can end the block early.
     */
    private static function block(const string& $body) : string
    {
        string $tag = '$carbon$';
        while ($body->contains($tag)) {
            string $longer = '$c';
            $longer->append($tag);
            $tag = $longer;
        }
        return "DO {$tag} {$body} {$tag}";
    }

    /**
     * The changes gathered so far as one `ALTER TABLE` of `$table`, already quoted, and none
     * left.
     */
    private static function flush(const string& $table, array<string>& $parts, array<string>& $out) : void
    {
        if ($parts->count() == 0) {
            return;
        }
        string $sql = "ALTER TABLE {$table} ";
        $sql->append(str::join($parts, ', '));
        $out[] = mv $sql;
        $parts->clear();
    }

    private static function type(const Column& $c) : result<string, Error>
    {
        return match ($c->kind) {
            Kind::bigint => .ok('BIGINT'),
            Kind::int => .ok('INTEGER'),
            Kind::smallint => .ok('SMALLINT'),
            Kind::tinyint => .ok('SMALLINT'),
            Kind::bool => .ok('BOOLEAN'),
            Kind::string($size) => Postgres::varchar($c->name, $size),
            Kind::text => .ok('TEXT'),
            Kind::json => .ok('JSONB'),
            Kind::decimal($p, $s) => Postgres::numeric($c->name, $p, $s),
            Kind::float => .ok('REAL'),
            Kind::double => .ok('DOUBLE PRECISION'),
            Kind::date => .ok('DATE'),
            Kind::datetime => .ok('TIMESTAMP'),
            Kind::time => .ok('INTERVAL'),
            Kind::bytes => .ok('BYTEA'),
        };
    }

    private static function varchar(const string& $column, uint32 $size) : result<string, Error>
    {
        if ($size == 0 || $size > 10485760) {
            return .error(.invalid("column {$column}: a string holds 1 to 10485760 characters, not {$size}"));
        }
        return .ok("VARCHAR({$size})");
    }

    private static function numeric(const string& $column, uint8 $precision, uint8 $scale) : result<string, Error>
    {
        if ($precision == 0 || $scale > $precision) {
            return .error(.invalid("column {$column}: NUMERIC({$precision},{$scale}) needs at least 1 digit and a scale of no more than the digits"));
        }
        return .ok("NUMERIC({$precision},{$scale})");
    }

    private const function index(const string& $table, const Index& $i, bool $missing) : string
    {
        string $out = 'CREATE ';
        if ($i->unique) {
            $out->append('UNIQUE ');
        }
        $out->append('INDEX ');
        if ($missing) {
            $out->append('IF NOT EXISTS ');
        }
        $out->append("{$this->name($i->named($table))} ON {$this->name($table)} ({$this->list($i->columns)})");
        return $out;
    }

    private const function foreign(const string& $table, const Foreign& $f) : string
    {
        return Literal::foreign($this->dialect, $table, $f);
    }

    private const function name(const string& $ident) : string
    {
        return Literal::name($this->dialect, $ident);
    }

    private const function list(const array<string>& $names) : string
    {
        return Literal::list($this->dialect, $names);
    }

    /**
     * The advisory lock key for `$name`.
     */
    private static function key(const string& $name) : string
    {
        string $quoted = Postgres::literal($name);
        return "hashtext({$quoted})";
    }

    /**
     * `$v` as an SQL literal, for a default: DDL takes no bound parameters.
     */
    public static function value(const Value& $v) : string
    {
        return Literal::value($v, .postgres);
    }

    /**
     * `$s` between single quotes, with quotes doubled, and as an escape string with its
     * backslashes doubled when it has any.
     */
    public static function literal(const string& $s) : string
    {
        return Literal::text($s, .postgres);
    }
}
