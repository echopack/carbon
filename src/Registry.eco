namespace carbon;

/**
 * What a `Db` and every session made from it share: how to build each registered repository,
 * and the store of every model. Sessions hold it rather than the `Db`, so the `Db` can keep its
 * root session without either keeping the other alive.
 */
internal class Registry
{
    internal map<type_id, erased> $factories = [];
    internal map<type_id, erased> $stores = [];

    internal constructor()
    {
    }

    internal const function has(type_id $id) : bool
    {
        return $this->factories->has($id);
    }

    /**
     * Keep `$make` as the way to build repositories of type `R`.
     */
    internal function factory<R>(function<R(Session)> $make) : void
    {
        $this->factories[type_id<R>()] = erased::from(Held<function<R(Session)>>($make));
    }

    /**
     * A repository of type `R` built for `$session`, null when none is registered.
     */
    internal function build<R>(Session $session) : R?
    {
        type_id $id = type_id<R>();
        if (!$this->factories->has($id)) {
            return null;
        }
        erased $held = $this->factories->get($id);
        Held<function<R(Session)>> $entry;
        // sound: only factory writes the key, always with this type
        unsafe {
            $entry = assume<Held<function<R(Session)>>>($held);
        }
        function<R(Session)> $make = $entry->value;
        R $repo = $make($session);
        return $repo;
    }

    /**
     * The one store of model `M`, made the first time it is asked for.
     */
    internal function store<M, K, S>() : Store<M, K, S>
    {
        type_id $id = type_id<Store<M, K, S>>();
        if (!$this->stores->has($id)) {
            $this->stores[$id] = erased::from(Held<Store<M, K, S>>(Store<M, K, S>()));
        }
        erased $held = $this->stores->get($id);
        Held<Store<M, K, S>> $entry;
        // sound: only this method writes the key, always with this type
        unsafe {
            $entry = assume<Held<Store<M, K, S>>>($held);
        }
        return $entry->value;
    }
}

/**
 * A value as the registry keeps it, behind an erased handle keyed by its type.
 */
internal class Held<T>
{
    internal T $value;

    internal constructor(T $value)
    {
        $this->value = $value;
    }
}
