namespace carbon::clock;

/**
 * A clock that only moves when told to.
 */
public class Fixed : Clock
{
    /**
     * Seconds since 1970-01-01T00:00:00Z.
     */
    public int64 $unix;

    public constructor(unix: int64 $seconds)
    {
        $this->unix = $seconds;
    }

    public function now() : hydrahon::DateTime
    {
        return hydrahon::DateTime(unix: $this->unix);
    }

    /**
     * Move the clock forward by `$seconds`.
     */
    public function advance(int64 $seconds) : void
    {
        $this->unix = $this->unix + $seconds;
    }
}
