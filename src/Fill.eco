namespace carbon;

/**
 * The relations to fill on models `M` already in hand, and the session they load in: what the
 * generated `PostLoad` keeps behind its `with…()` methods and `into()`.
 */
public struct Fill<M>
{
    internal Session $session;
    internal array<Eager<M>> $eager = [];

    public constructor(Session $session)
    {
        $this->session = $session;
    }

    /**
     * Fill `$relation` too.
     */
    public function add(Eager<M> $relation) : void
    {
        $this->eager[] = mv $relation;
    }

    /**
     * Fill every relation on `$models`, one query each, in the order they were added. `$seen`
     * holds `$models` already, so relations back to them reuse them.
     */
    public function into(array<M>& $models, Loaded $seen) : status<Error>
    {
        foreach ($this->eager as &$relation) {
            guard $relation->load($models, $this->session, $seen) else ($e) { return .error($e); }
        }
        return .ok();
    }
}
