namespace carbon;

/**
 * Everything that can go wrong in carbon. Every fallible call returns `result<T, Error>`, or
 * `status<Error>` when there is no value.
 */
public enum Error
{
    /**
     * hydrahon could not render the statement in the driver's dialect.
     */
    case render(hydrahon::Error $error);

    /**
     * The database refused the statement or the connection failed.
     */
    case driver(Failure $failure);

    /**
     * A lookup that needs a row found none.
     */
    case missing;

    /**
     * The model is not linked to a session, or its session is gone; `attach` links it to one.
     */
    case detached;

    /**
     * A column could not be read into its field.
     */
    case column(string $name, Problem $problem);

    /**
     * A repository hook or an observer refused the write, with why.
     */
    case refused(Refusal $why);

    /**
     * A transaction was started inside another one.
     */
    case nested;

    /**
     * A query refused its input, with the reason: a filter that does not parse, an unknown
     * option.
     */
    case invalid(string $reason);

    /**
     * The model's key changed since it was loaded or last saved. The key names the row, so
     * carbon refuses to write or delete through it.
     */
    case rekeyed;

    /**
     * `create` was handed a model whose row already exists; `save` writes its changes.
     */
    case persisted;

    /**
     * A write by key touched no row: the row is gone, or its version moved on since the model
     * was loaded. Load it again to see what is there now.
     */
    case stale;

    /**
     * What the app asked for or a relation needs is not registered on the `DB`: `$what` names
     * it. A repository left out is a wiring mistake; the generated `Carbon::check($db)` finds
     * every one of them at startup.
     */
    case unregistered(string $what);

    /**
     * `$what` is registered on the `DB` already; each type is registered once.
     */
    case registered(string $what);

    /**
     * The `DB` has one connection, and another session has a transaction open on it: the
     * statement would have run inside that transaction. Give the `DB` a `Source` that opens a
     * connection per session.
     */
    case busy;

    /**
     * The `DB` is sealed: its wiring is done, so nothing more is registered on it.
     */
    case sealed;

    /**
     * A `Migrator` was asked to roll back a batch holding migration `$id`, which has no `down`.
     * Nothing ran.
     */
    case irreversible(string $id);

    /**
     * The batch to roll back holds migrations the app has no class for, `$ids`: written by
     * another version of the app. Nothing ran.
     */
    case unknown(string $ids);

    /**
     * Another migrator held the database's lock for migrations for as long as this one waited.
     */
    case locked;

    /**
     * Migration `$id` failed, with why.
     */
    case migration(string $id, string $message);

    /**
     * Whether a unique key refused the write.
     */
    public const function duplicate() : bool
    {
        return $this->fault() == Fault::duplicate;
    }

    /**
     * Whether running the same work again can succeed: a deadlock or a lock wait timeout.
     */
    public const function retryable() : bool
    {
        return $this->fault() == Fault::deadlock;
    }

    /**
     * The driver's fault, or `other` for everything that did not come from the database.
     */
    public const function fault() : Fault
    {
        return match ($this) {
            Error::driver($f) => $f->fault,
            else => Fault::other,
        };
    }
}

namespace str;

/**
 * A readable message. This is what `"{$e}"` prints.
 */
public function from(const carbon::Error& $e) : string
{
    match ($e) {
        carbon::Error::render($r) => {
            return str::from($r);
        },
        carbon::Error::driver($f) => {
            string? $state = $f->state;
            if ($state != null) {
                string $s = guard $state;
                return "database error [{$s}]: {$f->message}";
            }
            return "database error: {$f->message}";
        },
        carbon::Error::missing => {
            return 'no matching row';
        },
        carbon::Error::detached => {
            return 'the model is not linked to a live session';
        },
        carbon::Error::column($name, $problem) => {
            $why = str::from($problem);
            return "column {$name} {$why}";
        },
        carbon::Error::refused($why) => {
            return "refused: {$why->message}";
        },
        carbon::Error::nested => {
            return 'a transaction is already open';
        },
        carbon::Error::invalid($reason) => {
            return "invalid: {$reason}";
        },
        carbon::Error::rekeyed => {
            return 'the key changed since the model was loaded';
        },
        carbon::Error::persisted => {
            return 'the model is already stored; save it instead';
        },
        carbon::Error::stale => {
            return 'the row is gone or changed since the model was loaded';
        },
        carbon::Error::unregistered($what) => {
            return "{$what} is not registered on the DB";
        },
        carbon::Error::registered($what) => {
            return "{$what} is registered on the DB already";
        },
        carbon::Error::busy => {
            return 'another session has a transaction open on the one connection';
        },
        carbon::Error::sealed => {
            return 'the DB is sealed; register everything before seal()';
        },
        carbon::Error::irreversible($id) => {
            return "migration {$id} has no down(), so its batch cannot be rolled back";
        },
        carbon::Error::unknown($ids) => {
            return "the batch to roll back holds migrations this app does not have: {$ids}";
        },
        carbon::Error::locked => {
            return 'another migrator is running';
        },
        carbon::Error::migration($id, $message) => {
            return "migration {$id}: {$message}";
        },
    };
    return '';
}
