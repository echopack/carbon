namespace carbon::sqlite;

/**
 * Binds hydrahon's parameters as libsqlite values: booleans as 0 or 1, decimals as their text,
 * dates and times as ISO text.
 */
internal struct Params : hydrahon::Binder
{
    public array<sqlite::Value> $values = [];

    public static function of(const hydrahon::Params& $from) : array<sqlite::Value>
    {
        Params $b = Params();
        foreach ($from as const &$v) {
            $b->value($v);
        }
        return mv $b->values;
    }

    internal function value(const hydrahon::Value& $v) : void
    {
        match ($v) {
            hydrahon::Value::none => {
                $this->none();
            },
            hydrahon::Value::bool($x) => {
                $this->bool($x);
            },
            hydrahon::Value::int($x) => {
                $this->int($x);
            },
            hydrahon::Value::uint($x) => {
                $this->uint($x);
            },
            hydrahon::Value::float($x) => {
                $this->float($x);
            },
            hydrahon::Value::decimal($x) => {
                $this->decimal($x);
            },
            hydrahon::Value::text($x) => {
                $this->text($x);
            },
            hydrahon::Value::bytes($x) => {
                $this->bytes($x);
            },
            hydrahon::Value::date($x) => {
                $this->date($x);
            },
            hydrahon::Value::datetime($x) => {
                $this->datetime($x);
            },
            hydrahon::Value::time($x) => {
                $this->time($x);
            },
        };
    }

    public function none() : void
    {
        $this->values[] = sqlite::Value::none;
    }

    public function bool(bool $v) : void
    {
        if ($v) {
            $this->values[] = sqlite::Value::int(1);
        } else {
            $this->values[] = sqlite::Value::int(0);
        }
    }

    public function int(int64 $v) : void
    {
        $this->values[] = sqlite::Value::int($v);
    }

    /**
     * SQLite has no unsigned integers: one past `int64` goes over as text.
     */
    public function uint(uint64 $v) : void
    {
        if ($v > 9223372036854775807) {
            $this->values[] = sqlite::Value::text("{$v}");
            return;
        }
        $this->values[] = sqlite::Value::int($v as int64);
    }

    public function float(float64 $v) : void
    {
        $this->values[] = sqlite::Value::float($v);
    }

    public function decimal(const hydrahon::Decimal& $v) : void
    {
        $this->values[] = sqlite::Value::text($v->text);
    }

    public function text(const string& $v) : void
    {
        $this->values[] = sqlite::Value::text($v);
    }

    public function bytes(const hydrahon::Bytes& $v) : void
    {
        $this->values[] = sqlite::Value::blob($v->data);
    }

    public function date(const hydrahon::Date& $v) : void
    {
        $this->values[] = sqlite::Value::text(Iso::date($v));
    }

    public function datetime(const hydrahon::DateTime& $v) : void
    {
        $this->values[] = sqlite::Value::text(Iso::datetime($v));
    }

    public function time(const hydrahon::Time& $v) : void
    {
        $this->values[] = sqlite::Value::text(Iso::time($v));
    }
}
