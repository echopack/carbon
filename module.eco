/*
 * carbon: an active record library for Echo.
 *
 * Work happens in a carbon::Session: the DB's own, $db->session(), or one
 * per request. Models are classes that keep a weak link to the session they
 * were loaded in, and conform to carbon::Model for save, delete and the
 * rest. A query is an immutable struct conforming to carbon::Query: scopes,
 * its own state, joins and terminals, with apply() to turn that state into
 * SQL right before it runs. A repository is a struct conforming to
 * carbon::Repository: writes, hooks, finders and its dependencies,
 * registered once on a carbon::DB by type and built for every session:
 * $session->repo<PostRepository>()->find()->withAuthor()->get(). The
 * generated Carbon::check($db) finds a repository left out at startup. Every
 * session opens a connection of its own from the DB's Source (a pool, such as
 * carbon::mysql::Source), so a transaction is that session's alone. All SQL is
 * built with hydrahon; a Driver renders it in its dialect and runs it.
 * The mapping between a model and its table is a Schema, written by
 * carbongen from #[carbon::*] attributes or by hand, with every column as a
 * static: PostTable::$title. A field with no column type of its own goes
 * through a carbon::Codec: carbon brings json (on libjson), csv and lines,
 * and any module can write more. time::timestamp (a DATETIME in UTC),
 * calendar::DateTime and calendar::Date (on echopack/calendar) need none,
 * and stamps come from the DB's calendar::Clock. Schema changes are #[carbon::migration]
 * classes, built with carbon::ddl, listed by carbongen in
 * Carbon::migrations() and run by a carbon::Migrator.
 */

#[module: "carbon"]
#[version: "0.1.0"]
#[epm::license: "MIT"]
#[epm::description: "an active record library for echo on top of hydrahon"]

#[requires: "echopack/hydrahon" { version: "^0.1", source: git "https://github.com/echopack/hydrahon" }]
#[requires: "echopack/calendar" { version: "^0.1", source: git "https://github.com/echopack/calendar" }]
#[requires: "echolang/libjson" { version: "^0.1", source: git "https://github.com/echolang/libjson" }]

#[sources: "src/**/*.eco"]

#[target: test] {
    // the fake driver the tests run on, compiled in: carbon-fake depends on carbon
    #[sources: "fake/src/*.eco"]
    #[sources: "tests/*.eco"]
    // the models the tests run on, and what carbongen wrote for them (scripts/test-gen.sh)
    #[sources: "tests/fixtures/src/**/*.eco"]
    #[sources: "tests/fixtures/.carbon/*.eco"]
}
