use carbon::{One, Many};
use carbon::relation::{Keys, Index, Loader};
use hydrahon::Value;
use fixtures::{World, Note, Tag, TagQuery, NoteQuery, NoteLoad, NoteRepository, TagRepository, NoteTagsRelation, TagNoteRelation, NoteTable, TagTable, noteRow, tagRow, selectNotes, selectTags, message};

test slots_start_unloaded
{
    One<Note> $one = .unloaded();
    assert(!$one->loaded());
    assert($one->get() == null);
    Many<Tag> $many = .unloaded();
    assert(!$many->loaded());
    assert($many->count() == 0);
}

test keys_are_distinct_in_first_seen_order
{
    Keys<int64> $k = Keys<int64>();
    assert($k->empty());
    $k->add(3);
    $k->add(1);
    $k->add(3);
    assert($k->list()->count() == 2);
    assert($k->list()[0] == 3 && $k->list()[1] == 1);
}

test index_groups_by_key
{
    Index<int64, string> $i = Index<int64, string>();
    $i->add(1, 'a');
    $i->add(2, 'b');
    $i->add(1, 'c');
    assert($i->all(1)->count() == 2);
    assert(($i->first(2) ?? '') == 'b');
    assert($i->first(9) == null);
    assert($i->all(9)->count() == 0);
}

test has_many_loads_with_one_query
{
    $w = World();
    $w->fake->rows([noteRow(1, 'a'), noteRow(2, 'b'), noteRow(3, 'c')]);
    $w->fake->rows([tagRow(10, 1, 'x'), tagRow(11, 3, 'y'), tagRow(12, 1, 'z')]);
    array<Note> $notes = guard $w->notes->find()->withTags()->get();
    assert($w->fake->count() == 2);
    assert($w->fake->last() == selectTags(' WHERE `tags`.`note_id` IN (?, ?, ?)'));
    assert($notes[0]->tags->loaded() && $notes[0]->tags->count() == 2);
    assert($notes[0]->tags->get()[1]->name == 'z');
    assert($notes[1]->tags->loaded() && $notes[1]->tags->count() == 0);
    assert($notes[2]->tags->get()[0]->id == 11);
    // loaded children are linked models too
    assert($notes[2]->tags->get()[0]->link->persisted());
}

test no_parents_no_query
{
    $w = World();
    array<Note> $none = [];
    guard $w->notes->load()->withTags()->into($none);
    assert($w->fake->count() == 0);
}

test belongs_to_fills_each_child
{
    $w = World();
    $w->fake->rows([tagRow(10, 1, 'x'), tagRow(11, 7, 'y'), tagRow(12, 1, 'z')]);
    $w->fake->rows([noteRow(1, 'parent')]);
    array<Tag> $tags = guard $w->tags->all();
    guard $w->tags->load()->withNote()->into($tags);
    assert($w->fake->last() == selectNotes(' WHERE `notes`.`id` IN (?, ?) AND `notes`.`deleted_at` IS NULL'));
    Note $p = guard $tags[0]->note->get();
    assert($p->title == 'parent');
    assert($tags[1]->note->loaded());
    assert($tags[1]->note->get() == null);
    Note $same = guard $tags[2]->note->get();
    assert($same->id == 1);
    // both children share the one loaded parent
    $same->title = 'renamed';
    assert($p->title == 'renamed');
}

test first_loads_relations_too
{
    $w = World();
    $w->fake->rows([noteRow(4, 'only')])->rows([tagRow(10, 4, 'x')]);
    Note $n = guard $w->notes->find()->withTags()->one();
    assert($n->tags->count() == 1);
    assert($w->fake->last() == selectTags(' WHERE `tags`.`note_id` IN (?)'));
}

test relations_nest_one_query_per_level
{
    $w = World();
    $w->fake->rows([noteRow(1, 'a'), noteRow(2, 'b')]);
    $w->fake->rows([tagRow(10, 1, 'x'), tagRow(11, 2, 'y'), tagRow(12, 1, 'z')]);
    // a relation of a relation: the constraint asks the related query for its own relation
    array<Note> $notes = guard $w->notes->find()->withTags(function(TagQuery $q) : TagQuery {
        return $q->withNote();
    })->get();
    // the tags' notes are the notes the tags were loaded for: no third query
    assert($w->fake->count() == 2);
    assert($w->fake->last() == selectTags(' WHERE `tags`.`note_id` IN (?, ?)'));
    Note $back = guard $notes[1]->tags->get()[0]->note->get();
    assert($back->title == 'b');
    assert($notes[0]->tags->get()[1]->note->loaded());
    // the very same model, shared rather than held
    assert($notes[1]->tags->get()[0]->note->shares());
    $back->title = 'renamed';
    assert($notes[1]->title == 'renamed');
}

test a_narrowed_relation_reads_its_own_copies
{
    $w = World();
    $w->fake->rows([noteRow(1, 'a', true)]);
    $w->fake->rows([tagRow(10, 1, 'x')]);
    $w->fake->rows([noteRow(1, 'a', true)]);
    // the note relation is narrowed, so the note the load holds may not be the one it would find
    array<Note> $notes = guard $w->notes->find()->withTags(function(TagQuery $q) : TagQuery {
        return $q->withNote(function(NoteQuery $n) : NoteQuery {
            return $n->pinned();
        });
    })->get();
    assert($w->fake->count() == 3);
    Note $copy = guard $notes[0]->tags->get()[0]->note->get();
    assert(!$notes[0]->tags->get()[0]->note->shares());
    $copy->title = 'copy';
    assert($notes[0]->title == 'a');
}

/**
 * Notes with their tags and the tags' notes, returned with every note dropped but the tags.
 */
internal function tagsOnly(World $w) : array<Tag>
{
    array<Note> $notes = guard $w->notes->find()->withTags(function(TagQuery $q) : TagQuery {
        return $q->withNote();
    })->get();
    array<Tag> $tags = $notes[0]->tags->get();
    return $tags;
}

test a_shared_slot_reads_nothing_once_its_model_is_gone
{
    $w = World();
    $w->fake->rows([noteRow(1, 'a')])->rows([tagRow(10, 1, 'x')]);
    array<Tag> $tags = tagsOnly($w);
    // the tag never kept its note alive: no cycle between the two
    assert($tags[0]->note->loaded());
    assert($tags[0]->note->get() == null);
}

test load_shares_the_models_in_hand
{
    $w = World();
    $w->fake->rows([noteRow(1, 'a'), noteRow(2, 'b')])->rows([tagRow(10, 2, 'x')]);
    array<Note> $list = guard $w->notes->all();
    guard $w->notes->load()->withTags(function(TagQuery $q) : TagQuery {
        return $q->withNote();
    })->into($list);
    assert($w->fake->count() == 2);
    Note $back = guard $list[1]->tags->get()[0]->note->get();
    $back->pinned = true;
    assert($list[1]->pinned);
}

test a_nested_level_without_rows_runs_no_query
{
    $w = World();
    $w->fake->rows([noteRow(1, 'a')])->rows([]);
    // nested through the relation classes themselves, the way a hand-written relation would
    array<Note> $notes = guard $w->notes->find()->with(NoteTagsRelation()->with(TagNoteRelation()))->get();
    assert($w->fake->count() == 2);
    assert($notes[0]->tags->loaded() && $notes[0]->tags->count() == 0);
}

test a_relation_takes_conditions
{
    $w = World();
    $w->fake->rows([noteRow(1, 'a')])->rows([]);
    guard $w->notes->find()->with(NoteTagsRelation()->where(TagTable::$name == 'x'))->get();
    assert($w->fake->last() == selectTags(' WHERE `tags`.`note_id` IN (?) AND `tags`.`name` = ?'));
    assert($w->fake->sent(1, [Value::from(1), Value::from('x')]));
}

test a_relation_starts_from_a_ready_query
{
    $w = World();
    TagQuery $named = $w->tags->find()->where(TagTable::$name == 'x')->order(asc: TagTable::$name);
    $w->fake->rows([noteRow(1, 'a')])->rows([]);
    guard $w->notes->find()->with(NoteTagsRelation()->from($named))->get();
    assert($w->fake->last() == selectTags(' WHERE `tags`.`name` = ? AND `tags`.`note_id` IN (?) ORDER BY `tags`.`name` ASC'));
    // the ready query itself is left alone
    $w->fake->rows([]);
    guard $named->get();
    assert($w->fake->last() == selectTags(' WHERE `tags`.`name` = ? ORDER BY `tags`.`name` ASC'));
    // a scope on the ready query applies: soft deleted parents too
    $w->fake->rows([tagRow(10, 1, 'x')])->rows([]);
    guard $w->tags->find()->with(TagNoteRelation()->from($w->notes->find()->scope(.all)))->get();
    assert($w->fake->last() == selectNotes(' WHERE `notes`.`id` IN (?)'));
}

test a_callback_changes_the_related_query
{
    $w = World();
    $w->fake->rows([noteRow(1, 'a')])->rows([]);
    guard $w->notes->find()->with(NoteTagsRelation()->constrain(function(TagQuery $q) : TagQuery {
        return $q->where(TagTable::$name != 'hidden')->order(asc: TagTable::$name);
    })->where(TagTable::$name == 'x'))->get();
    // keys first, then terms, then what the callback added
    assert($w->fake->last() == selectTags(' WHERE `tags`.`note_id` IN (?) AND `tags`.`name` = ? AND `tags`.`name` <> ? ORDER BY `tags`.`name` ASC'));
    assert($w->fake->sent(1, [Value::from(1), Value::from('x'), Value::from('hidden')]));
    // on a relation built elsewhere, a callback can widen the scope
    $w->fake->rows([tagRow(10, 1, 'x')])->rows([]);
    guard $w->tags->find()->with(TagNoteRelation()->constrain(function(NoteQuery $q) : NoteQuery {
        return $q->scope(.all);
    }))->get();
    assert($w->fake->last() == selectNotes(' WHERE `notes`.`id` IN (?)'));
    // the related query's own scopes work in a callback
    $w->fake->rows([tagRow(10, 1, 'x')])->rows([]);
    guard $w->tags->find()->withNote(function(NoteQuery $q) : NoteQuery {
        return $q->pinned();
    })->get();
    assert($w->fake->last() == selectNotes(' WHERE `notes`.`id` IN (?) AND `notes`.`pinned` AND `notes`.`deleted_at` IS NULL'));
}

test a_relation_loaded_twice_runs_the_same_query
{
    $w = World();
    NoteLoad $load = $w->notes->load()->withTags(function(TagQuery $q) : TagQuery {
        return $q->where(TagTable::$name == 'x');
    });
    array<Note> $notes = [Note($id: 1, $title: 'a')];
    $w->fake->rows([])->rows([]);
    guard $load->into($notes);
    string $first = $w->fake->last();
    guard $load->into($notes);
    assert($w->fake->last() == $first);
    assert($first == selectTags(' WHERE `tags`.`note_id` IN (?) AND `tags`.`name` = ?'));
}

test filling_several_relations_runs_one_query_each
{
    $w = World();
    array<Tag> $tags = [Tag($id: 10, $noteId: 1, $name: 'x'), Tag($id: 11, $noteId: 2, $name: 'y')];
    $w->fake->rows([noteRow(1, 'a'), noteRow(2, 'b')]);
    guard $w->tags->load()->withNote()->into($tags);
    assert($w->fake->count() == 1);
    Note $first = guard $tags[0]->note->get();
    assert($first->title == 'a');
    // nesting works in hand too: the notes of the tags, and their tags
    $w->fake->rows([noteRow(1, 'a'), noteRow(2, 'b')])->rows([tagRow(10, 1, 'x')]);
    guard $w->tags->load()->withNote(function(NoteQuery $q) : NoteQuery {
        return $q->withTags();
    })->into($tags);
    assert($w->fake->count() == 3);
    Note $again = guard $tags[0]->note->get();
    assert($again->tags->loaded() && $again->tags->count() == 1);
}

test a_relation_starts_from_the_registered_repository
{
    $w = World();
    // the note repository narrows every query it starts; loading notes as a relation goes through it
    $w->notes->flags->pinnedOnly = true;
    $w->fake->rows([tagRow(10, 1, 'x')])->rows([]);
    guard $w->tags->find()->withNote()->get();
    assert($w->fake->last() == selectNotes(' WHERE `notes`.`pinned` AND `notes`.`id` IN (?) AND `notes`.`deleted_at` IS NULL'));
}

test a_relation_to_a_model_without_a_registered_repository_is_an_error
{
    carbon::fake::Driver<hydrahon::Mysql> $fake = carbon::fake::Driver<hydrahon::Mysql>();
    $fake->rows([tagRow(10, 1, 'x')]);
    carbon::DB $db = carbon::DB($fake);
    guard $db->register<NoteRepository>();
    array<Note> $list = [Note($id: 1, $title: 'a')];
    NoteRepository $notes = guard $db->session()->repo<NoteRepository>();
    status<carbon::Error> $s = $notes->load()->withTags()->into($list);
    assert(fixtures::message($s) == 'fixtures::TagRepository is not registered on the DB');
    // refused before the query ran
    assert($fake->count() == 0);
}

/**
 * What a loader built by hand filled each slot with, in order.
 */
internal class Filled
{
    public array<string> $heard = [];

    public function said() : string
    {
        return str::join($this->heard, ' | ');
    }
}

/**
 * A has one loader from notes to a tag of theirs, filling `$filled` instead of a slot. A tag
 * named `loose` holds no note.
 */
internal function firstTag(Filled $filled) : Loader<Note, Tag, int64, int64, TagQuery, TagRepository>
{
    return Loader<Note, Tag, int64, int64, TagQuery, TagRepository>(
        hasOne: 'fixtures::TagRepository',
        function(Note $m) : int64? { return $m->id; },
        function(Tag $t) : int64? {
            if ($t->name == 'loose') {
                return null;
            }
            return $t->noteId;
        },
        function(Tag $t) : int64 { return $t->id; },
        function(array<int64> $keys) : hydrahon::Term<bool> { return TagTable::$noteId in $keys; },
        function[$filled](Note $m, Tag? $found) : void {
            if ($found == null) {
                $filled->heard[] = "set {$m->id}:none";
                return;
            }
            Tag $t = guard $found;
            $filled->heard[] = "set {$m->id}:{$t->id}";
        },
        function[$filled](Note $m, Tag $held) : void {
            $filled->heard[] = "share {$m->id}:{$held->id}";
        }
    );
}

/**
 * A belongs to loader from tags to their note, filling `$filled`. A tag named `orphan` holds no
 * note.
 */
internal function parentNote(Filled $filled) : Loader<Tag, Note, int64, int64, NoteQuery, NoteRepository>
{
    return Loader<Tag, Note, int64, int64, NoteQuery, NoteRepository>(
        belongsTo: 'fixtures::NoteRepository',
        function(Tag $m) : int64? {
            if ($m->name == 'orphan') {
                return null;
            }
            return $m->noteId;
        },
        function(Note $t) : int64? { return $t->id; },
        function(Note $t) : int64 { return $t->id; },
        function(array<int64> $keys) : hydrahon::Term<bool> { return NoteTable::$id in $keys; },
        function[$filled](Tag $m, Note? $found) : void {
            if ($found == null) {
                $filled->heard[] = "set {$m->id}:none";
                return;
            }
            Note $n = guard $found;
            $filled->heard[] = "set {$m->id}:{$n->id}";
        },
        function[$filled](Tag $m, Note $held) : void {
            $filled->heard[] = "share {$m->id}:{$held->id}";
        }
    );
}

test has_one_takes_the_first_row_of_each_model
{
    $w = World();
    $w->fake->rows([noteRow(1, 'a'), noteRow(2, 'b'), noteRow(3, 'c')]);
    array<Note> $notes = guard $w->notes->all();
    $w->fake->rows([tagRow(10, 1, 'x'), tagRow(11, 1, 'y'), tagRow(12, 3, 'loose')]);
    Filled $filled = Filled();
    guard firstTag($filled)->load($notes, $w->session, carbon::Loaded());
    assert($w->fake->last() == selectTags(' WHERE `tags`.`note_id` IN (?, ?, ?)'));
    // a row holding no note belongs to none of them
    assert($filled->said() == 'set 1:10 | set 2:none | set 3:none');
}

test has_one_shares_a_model_the_load_holds_unless_narrowed
{
    $w = World();
    $w->fake->rows([noteRow(1, 'a')]);
    array<Note> $notes = guard $w->notes->all();
    Tag $held = Tag($id: 10, $noteId: 1, $name: 'x');
    carbon::Loaded $seen = carbon::Loaded();
    $seen->add<int64, Tag>(10, $held);
    $w->fake->rows([tagRow(10, 1, 'x')]);
    Filled $filled = Filled();
    guard firstTag($filled)->load($notes, $w->session, $seen);
    assert($filled->said() == 'share 1:10');
    // a narrowed relation keeps the copy it read: the one held had none of its conditions
    $w->fake->rows([tagRow(10, 1, 'x')]);
    Filled $narrowed = Filled();
    $loader = firstTag($narrowed);
    $loader->where(TagTable::$name == 'x');
    guard $loader->load($notes, $w->session, $seen);
    assert($narrowed->said() == 'set 1:10');
}

test a_model_without_a_key_asks_for_nothing
{
    $w = World();
    array<Tag> $tags = [Tag($id: 1, $noteId: 5, $name: 'a'), Tag($id: 2, $noteId: 6, $name: 'orphan')];
    $w->fake->rows([noteRow(5, 'five')]);
    Filled $filled = Filled();
    guard parentNote($filled)->load($tags, $w->session, carbon::Loaded());
    assert($w->fake->last() == selectNotes(' WHERE `notes`.`id` IN (?) AND `notes`.`deleted_at` IS NULL'));
    assert($filled->said() == 'set 1:5 | set 2:none');
    // with no key among them, no query runs at all
    array<Tag> $orphans = [Tag($id: 3, $noteId: 7, $name: 'orphan')];
    Filled $none = Filled();
    guard parentNote($none)->load($orphans, $w->session, carbon::Loaded());
    assert($w->fake->count() == 1);
    assert($none->said() == 'set 3:none');
}
