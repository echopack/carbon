use carbon::{DB, Connection, Error, Event, Fault, Failure, Problem, Statement, Written, Traits};
use std::time;
use carbon::change::{Changes, Snapshot};
use carbon::listen::Log;
use carbon::select::{Selected, Pick};
use carbon::fake;
use hydrahon::{Value, DateTime, Date, Time, Bytes, Decimal, Mysql};
use fixtures::{World, Note, Tag, Setting, NoteQuery, NoteTable, TagTable, SettingTable, NoteCountTable, noteRow, tagRow, failure, message, selectNotes, selectTags};

test every_error_reads_well
{
    Error $detached = .detached;
    assert(str::from($detached) == 'the model is not linked to a live session');
    Error $nested = .nested;
    assert(str::from($nested) == 'a transaction is already open');
    Error $invalid = .invalid('bad filter');
    assert(str::from($invalid) == 'invalid: bad filter');
    Error $rekeyed = .rekeyed;
    assert(str::from($rekeyed) == 'the key changed since the model was loaded');
    Error $persisted = .persisted;
    assert(str::from($persisted) == 'the model is already stored; save it instead');
    Error $range = .column('n', .range);
    assert(str::from($range) == 'column n does not fit the field');
    Error $unknown = .column('mood', .unknown);
    assert(str::from($unknown) == 'column mood matches no enum case');
    Error $codec = .column('when', .codec('not a date'));
    assert(str::from($codec) == 'column when was refused by its codec: not a date');
    Error $mismatch = .column('id', .mismatch);
    assert(str::from($mismatch) == 'column id holds another kind of value than the field');
    // only a driver failure has a fault of its own
    assert($invalid->fault() == Fault::other);
    assert(!$nested->retryable());
    Error $ref = .driver(Failure(.reference, 'gone'));
    assert($ref->fault() == Fault::reference);
    assert(!$ref->duplicate());
}

test a_problem_tells_null_from_another_kind
{
    $fake = fake::Driver<Mysql>();
    $fake->rows([[Value::none, Value::from('x')]]);
    DB $db = DB($fake);
    carbon::Cursor $c = guard $db->connection()->query(hydrahon::Select(from: hydrahon::Table(name: 't')));
    guard $c->step();
    assert(str::from(Problem::of($c, 0)) == 'is NULL but the field is not nullable');
    assert(str::from(Problem::of($c, 1)) == 'holds another kind of value than the field');
}

test the_fake_reads_every_kind
{
    $fake = fake::Driver<Mysql>();
    DateTime $at = DateTime(2024, 2, 29, 23, 59, 58, 7);
    $fake->rows([[
        Value::uint(8),
        Value::from('t'),
        Value::from(Decimal('9.99')),
        Value::from(Bytes('raw')),
        Value::from(Date(2024, 2, 29)),
        Value::from($at),
        Value::from(Time(true, 838, 59, 58, 1)),
        Value::from(false),
    ]]);
    DB $db = DB($fake);
    carbon::Cursor $c = guard $db->connection()->query(hydrahon::Select(from: hydrahon::Table(name: 't')));
    // before the first step there is no row to read
    assert($c->isNull(0));
    assert($c->text(1) == null);
    guard $c->step();
    assert(($c->uint(0) ?? 0) == 8);
    assert($c->bool(0) ?? false);
    assert($c->int(0) == null);
    assert(($c->text(1) ?? '') == 't');
    Decimal $d = guard $c->decimal(2);
    assert($d->text == '9.99');
    Bytes $b = guard $c->bytes(3);
    assert($b->data == 'raw');
    Date $day = guard $c->date(4);
    assert($day->year == 2024 && $day->month == 2 && $day->day == 29);
    DateTime $dt = guard $c->datetime(5);
    assert($dt->micro == 7 && $dt->second == 58);
    Time $t = guard $c->time(6);
    assert($t->negative && $t->hours == 838 && $t->micro == 1);
    // a boolean reads as an integer the way MySQL sends one
    assert(($c->int(7) ?? 9) == 0);
    // a value of another kind is null, never a conversion
    assert($c->float(1) == null);
    assert($c->decimal(1) == null);
    assert($c->bytes(1) == null);
    assert($c->date(5) == null);
    assert($c->datetime(4) == null);
    assert($c->time(5) == null);
    assert($c->uint(1) == null);
    assert($c->bool(1) == null);
}

test the_fake_knows_its_dialect
{
    fake::Driver<Mysql> $my = fake::Driver<Mysql>();
    assert(!$my->traits()->returning);
    fake::Driver<hydrahon::Postgres> $pg = fake::Driver<hydrahon::Postgres>();
    assert($pg->traits()->returning);
    assert($my->last() == '');
    assert($my->pending() == 0);
    $my->rows([])->written();
    assert($my->pending() == 2);
}

test sent_compares_count_and_kind
{
    $w = World();
    $w->fake->rows([]);
    guard $w->notes->get(3);
    assert($w->fake->sent(0, [Value::from(3)]));
    assert(!$w->fake->sent(0, [Value::uint(3)]));
    assert(!$w->fake->sent(0, [Value::from(3), Value::from(3)]));
    array<Value> $none = [];
    assert(!$w->fake->sent(0, $none));
    assert($w->fake->params(0)->count() == 1);
}

