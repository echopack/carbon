use carbon::ddl::{Table, Alter, Column, Postgres};
use hydrahon::{Value, Date, DateTime, Time, Bytes, Decimal};

test postgres_creates_a_table_with_an_identity_key
{
    Table $users = Table('users')
        ->id()
        ->string('email', 190, $unique: true)
        ->string('name', 190)
        ->bool('admin', $default: false)
        ->timestamps();
    assert(created(Postgres(), $users) == 'CREATE TABLE "users" ("id" BIGINT NOT NULL GENERATED BY DEFAULT AS IDENTITY PRIMARY KEY, "email" VARCHAR(190) NOT NULL UNIQUE, "name" VARCHAR(190) NOT NULL, "admin" BOOLEAN NOT NULL DEFAULT FALSE, "created_at" TIMESTAMP NULL, "updated_at" TIMESTAMP NULL)');
}

test postgres_writes_indexes_as_statements_of_their_own
{
    Table $posts = Table('posts')
        ->id()
        ->bigint('author_id')
        ->tinyint('status', $default: 0, $unsigned: true)
        ->json('meta')
        ->softDeletes()
        ->index(['author_id', 'status'])
        ->unique(['author_id', 'meta'], $name: 'one_meta')
        ->foreign('author_id', 'users', $onDelete: .cascade);
    array<string> $want = [
        'CREATE TABLE "posts" ("id" BIGINT NOT NULL GENERATED BY DEFAULT AS IDENTITY PRIMARY KEY, "author_id" BIGINT NOT NULL, "status" SMALLINT NOT NULL DEFAULT 0 CHECK ("status" >= 0), "meta" JSONB NOT NULL, "deleted_at" TIMESTAMP NULL, CONSTRAINT "posts_author_id_foreign" FOREIGN KEY ("author_id") REFERENCES "users" ("id") ON DELETE CASCADE ON UPDATE RESTRICT)',
        'CREATE INDEX "posts_author_id_status_index" ON "posts" ("author_id", "status")',
        'CREATE UNIQUE INDEX "one_meta" ON "posts" ("author_id", "meta")',
    ];
    assert(created(Postgres(), $posts) == str::join($want, "\n"));
}

test postgres_makes_a_missing_table_and_its_indexes_only_once
{
    Table $pivot = Table('movie_genres')
        ->bigint('movie_id')
        ->string('genre', 32)
        ->primary(['movie_id', 'genre'])
        ->index(['genre'])
        ->ifMissing();
    array<string> $want = [
        'CREATE TABLE IF NOT EXISTS "movie_genres" ("movie_id" BIGINT NOT NULL, "genre" VARCHAR(32) NOT NULL, PRIMARY KEY ("movie_id", "genre"))',
        'CREATE INDEX IF NOT EXISTS "movie_genres_genre_index" ON "movie_genres" ("genre")',
    ];
    assert(created(Postgres(), $pivot) == str::join($want, "\n"));
}

test postgres_has_a_type_for_every_kind
{
    Table $all = Table('kinds')
        ->int('a', $nullable: true)
        ->smallint('b')
        ->text('c')
        ->decimal('d', 8, 3)
        ->float('e')
        ->double('f')
        ->date('g')
        ->datetime('h')
        ->time('i')
        ->bytes('j');
    assert(created(Postgres(), $all) == 'CREATE TABLE "kinds" ("a" INTEGER NULL, "b" SMALLINT NOT NULL, "c" TEXT NOT NULL, "d" NUMERIC(8,3) NOT NULL, "e" REAL NOT NULL, "f" DOUBLE PRECISION NOT NULL, "g" DATE NOT NULL, "h" TIMESTAMP NOT NULL, "i" INTERVAL NOT NULL, "j" BYTEA NOT NULL)');
}

test postgres_writes_defaults_as_literals
{
    assert(Postgres::value(Value::none) == 'NULL');
    assert(Postgres::value(Value::from(true)) == 'TRUE');
    assert(Postgres::value(Value::from(-7 as int64)) == '-7');
    assert(Postgres::value(Value::from(Decimal('12.50'))) == '12.50');
    // a backslash makes an escape string, read the same whatever standard_conforming_strings says
    assert(Postgres::value(Value::from("it's a \\ path")) == "E'it''s a \\\\ path'");
    assert(Postgres::value(Value::from("it's plain")) == "'it''s plain'");
    assert(Postgres::value(Value::from(Bytes("\x01\x7F"))) == "E'\\\\x017F'::bytea");
    assert(Postgres::value(Value::from(Date(2026, 1, 9))) == "'2026-01-09'");
    assert(Postgres::value(Value::from(DateTime(2026, 10, 29, 8, 5, 3, 120))) == "'2026-10-29 08:05:03.000120'");
    Time $t = Time();
    $t->hours = 9;
    $t->minute = 30;
    assert(Postgres::value(Value::from($t)) == "'09:30:00'");
    // a duration, negative or past a day, is an INTERVAL too
    assert(Postgres::value(Value::from(Time(true, 30, 0, 0, 0))) == "'-30:00:00'");

    // unlike MySQL, a TEXT or JSON column takes a default
    Table $d = Table('d')->add(Column('body', .text, false, Value::from('none yet')))->json('meta', $nullable: true);
    assert(created(Postgres(), $d) == 'CREATE TABLE "d" ("body" TEXT NOT NULL DEFAULT \'none yet\', "meta" JSONB NULL)');
}

test what_postgres_cannot_express_is_refused
{
    assert(created(Postgres(), Table('empty')) == 'invalid: table empty has no columns');
    assert(created(Postgres(), Table('t')->string('s', 0)) == 'invalid: column s: a string holds 1 to 10485760 characters, not 0');
    assert(created(Postgres(), Table('t')->decimal('d', 4, 6)) == 'invalid: column d: NUMERIC(4,6) needs at least 1 digit and a scale of no more than the digits');
    Column $neg = Column('f', .float, false, null, true);
    assert(created(Postgres(), Table('t')->add($neg)) == 'invalid: column f: only a whole number can be unsigned');
    Column $count = Column('s', .string(8));
    $count->increments = true;
    assert(created(Postgres(), Table('t')->add($count)) == 'invalid: column s: only a whole number can count up');
    Column $defaulted = Column('n', .bigint, false, Value::from(1 as int64));
    $defaulted->increments = true;
    assert(created(Postgres(), Table('t')->add($defaulted)) == 'invalid: column n: a column that counts up takes no NULL and no default');
    Column $keyed = Column('email', .string(255));
    $keyed->unique = true;
    assert(altered(Postgres(), Alter('t')->modify($keyed)) == 'invalid: column email: Postgres changes only the type, NULL, default and identity of a column; add a key, an index or a check as a change of its own');
    assert(altered(Postgres(), Alter('t')) == 'invalid: altering t changes nothing');
}

test postgres_alters_in_order_with_indexes_and_renames_apart
{
    Alter $a = Alter('users')
        ->string('nickname', 64, $nullable: true)
        ->drop('legacy')
        ->rename('name', 'full_name')
        ->modify(Column('email', .string(255), false, Value::from('')))
        ->unique(['nickname'])
        ->index(['full_name'], $name: 'by_name')
        ->dropIndex('users_old_index')
        ->foreign('team_id', 'teams', $onDelete: .setNull, $onUpdate: .noAction)
        ->dropForeign('users_org_id_foreign')
        ->modify(Column('bio', .text, true));
    array<string> $want = [
        'ALTER TABLE "users" ADD COLUMN "nickname" VARCHAR(64) NULL, DROP COLUMN "legacy"',
        'ALTER TABLE "users" RENAME COLUMN "name" TO "full_name"',
        'ALTER TABLE "users" ALTER COLUMN "email" DROP IDENTITY IF EXISTS, ALTER COLUMN "email" DROP DEFAULT, ALTER COLUMN "email" TYPE VARCHAR(255), ALTER COLUMN "email" SET NOT NULL, ALTER COLUMN "email" SET DEFAULT \'\'',
        'CREATE UNIQUE INDEX "users_nickname_unique" ON "users" ("nickname")',
        'CREATE INDEX "by_name" ON "users" ("full_name")',
        'DROP INDEX "users_old_index"',
        'ALTER TABLE "users" ADD CONSTRAINT "users_team_id_foreign" FOREIGN KEY ("team_id") REFERENCES "teams" ("id") ON DELETE SET NULL ON UPDATE NO ACTION, DROP CONSTRAINT "users_org_id_foreign", ALTER COLUMN "bio" DROP IDENTITY IF EXISTS, ALTER COLUMN "bio" DROP DEFAULT, ALTER COLUMN "bio" TYPE TEXT USING "bio"::TEXT, ALTER COLUMN "bio" DROP NOT NULL',
    ];
    assert(altered(Postgres(), $a) == str::join($want, "\n"));
}

test postgres_drops_renames_and_locks_tables
{
    Postgres $g = Postgres();
    assert($g->drop('users') == 'DROP TABLE "users"');
    assert($g->drop('users', $exists: true) == 'DROP TABLE IF EXISTS "users"');
    assert($g->rename('users', 'people') == 'ALTER TABLE "users" RENAME TO "people"');
    // identifiers are quoted the way hydrahon quotes them
    assert($g->drop('we"ird') == 'DROP TABLE "we""ird"');
    assert($g->lock("app's", 2) == "WITH RECURSIVE attempt(n, got) AS (SELECT 0, pg_try_advisory_lock(hashtext('app''s')) UNION ALL SELECT n + 1, pg_try_advisory_lock(hashtext('app''s')) FROM attempt WHERE NOT got AND n < 20 AND pg_sleep(0.1) IS NOT NULL) SELECT got::int FROM attempt ORDER BY n DESC LIMIT 1");
    assert($g->unlock('carbon_migrations') == "SELECT pg_advisory_unlock(hashtext('carbon_migrations'))");
    assert($g->transactional());
    array<string> $advance = $g->advance('users', 'id');
    assert($advance->count() == 1);
    // a column without an identity is an error, not a setval on NULL that moves nothing
    assert($advance[0] == 'DO $carbon$ DECLARE s text := pg_get_serial_sequence(\'"users"\', \'id\'); BEGIN IF s IS NULL THEN RAISE EXCEPTION \'column %.% has no identity to advance\', \'users\', \'id\'; END IF; PERFORM setval(s, (SELECT COALESCE(MAX("id"), 0) + 1 FROM "users"), false); END $carbon$');
    // a name holding the dollar quote's tag gets a longer one
    assert($g->advance('t$carbon$', 'id')[0]->starts('DO $c$carbon$ DECLARE'));
}

test postgres_modifies_a_column_that_counts_up
{
    Column $id = Column('id', .bigint);
    $id->increments = true;
    array<string> $want = [
        // the old identity goes before the type changes, and a new one sees the new type
        'ALTER TABLE "t" ALTER COLUMN "id" DROP IDENTITY IF EXISTS, ALTER COLUMN "id" DROP DEFAULT, ALTER COLUMN "id" TYPE BIGINT USING (CASE "id"::text WHEN \'true\' THEN 1 WHEN \'false\' THEN 0 ELSE "id"::text::numeric END)::BIGINT, ALTER COLUMN "id" SET NOT NULL',
        'ALTER TABLE "t" ALTER COLUMN "id" ADD GENERATED BY DEFAULT AS IDENTITY',
        'DO $carbon$ DECLARE s text := pg_get_serial_sequence(\'"t"\', \'id\'); BEGIN IF s IS NULL THEN RAISE EXCEPTION \'column %.% has no identity to advance\', \'t\', \'id\'; END IF; PERFORM setval(s, (SELECT COALESCE(MAX("id"), 0) + 1 FROM "t"), false); END $carbon$',
    ];
    assert(altered(Postgres(), Alter('t')->modify($id)) == str::join($want, "\n"));

    Column $text = Column('id', .string(8));
    $text->increments = true;
    assert(altered(Postgres(), Alter('t')->modify($text)) == 'invalid: column id: only a whole number can count up');
}

test postgres_drops_the_old_default_before_the_type_changes
{
    // the old default would be cast to the new type, and a string one cannot be
    assert(altered(Postgres(), Alter('t')->modify(Column('status', .int, false, Value::from(0 as int64)))) == 'ALTER TABLE "t" ALTER COLUMN "status" DROP IDENTITY IF EXISTS, ALTER COLUMN "status" DROP DEFAULT, ALTER COLUMN "status" TYPE INTEGER USING (CASE "status"::text WHEN \'true\' THEN 1 WHEN \'false\' THEN 0 ELSE "status"::text::numeric END)::INTEGER, ALTER COLUMN "status" SET NOT NULL, ALTER COLUMN "status" SET DEFAULT 0');
}

test postgres_casts_between_a_boolean_and_a_whole_number
{
    // Postgres has no cast from SMALLINT to BOOLEAN or back, so both go through the text
    assert(altered(Postgres(), Alter('t')->modify(Column('flag', .bool, false))) == 'ALTER TABLE "t" ALTER COLUMN "flag" DROP IDENTITY IF EXISTS, ALTER COLUMN "flag" DROP DEFAULT, ALTER COLUMN "flag" TYPE BOOLEAN USING CASE WHEN "flag"::text ~ \'^-?[0-9.]+$\' THEN "flag"::text::numeric <> 0 ELSE "flag"::text::boolean END, ALTER COLUMN "flag" SET NOT NULL');
    assert(altered(Postgres(), Alter('t')->modify(Column('flag', .tinyint, false))) == 'ALTER TABLE "t" ALTER COLUMN "flag" DROP IDENTITY IF EXISTS, ALTER COLUMN "flag" DROP DEFAULT, ALTER COLUMN "flag" TYPE SMALLINT USING (CASE "flag"::text WHEN \'true\' THEN 1 WHEN \'false\' THEN 0 ELSE "flag"::text::numeric END)::SMALLINT, ALTER COLUMN "flag" SET NOT NULL');
}
