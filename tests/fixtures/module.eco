/*
 * carbon-fixtures: the models carbon's own tests run on. Note, Tag and
 * Profile are generated by carbongen like any app's; Setting's schema is written by
 * hand, the way a schema can always be. This module is never built on its
 * own: it is here so carbongen has a module to read, and carbon's test
 * target compiles its sources and the generated file directly.
 */

#[module: "carbon-fixtures"]
#[version: "0.1.0"]

#[depends: "../.."]
// World runs every test on the fake
#[depends: "../../fake"]
#[requires: "echopack/hydrahon" { version: "^0.1", source: git "https://github.com/echopack/hydrahon" }]
#[requires: "echopack/calendar" { version: "^0.1", source: git "https://github.com/echopack/calendar" }]
#[requires: "echolang/libjson" { version: "^0.1", source: git "https://github.com/echolang/libjson" }]

#[sources: "src/**/*.eco"]

#[if: !CARBON_NOGEN]
#[sources: ".carbon/*.eco"]
#[end]
