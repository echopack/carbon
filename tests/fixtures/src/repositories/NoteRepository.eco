namespace fixtures;

/**
 * Notes, with hooks, a finder of its own and two things it is built with: the trail its hooks
 * write to, and flags that narrow its queries. World's factory hands every repository it builds
 * the same two, so a note saved through its link reaches the same trail.
 */
public struct NoteRepository : carbon::Repository<Note, NoteQuery, int64>, NoteWiring
{
    public carbon::Session $session;

    /**
     * What the hooks heard, shared with observers so the order shows.
     */
    public Trail $trail = Trail();

    /**
     * How every query this repository starts is narrowed, relations included.
     */
    public NoteFlags $flags = NoteFlags();

    public function query() : NoteQuery
    {
        NoteQuery $q = NoteQuery($this->session);
        if ($this->flags->pinnedOnly) {
            return $q->pinned();
        }
        return $q;
    }

    /**
     * Trims titles on every save, refuses an empty one.
     */
    public function before(carbon::Event $event, Note& $note) : status<carbon::Error>
    {
        $this->trail->heard[] = "repo before {$event->value()}";
        // a session made for an editor says who wrote it
        Editor? $editor = $this->session->get<Editor>();
        if ($editor != null) {
            Editor $e = guard $editor;
            $this->trail->heard[] = "by {$e->name}";
        }
        if ($event->saves()) {
            $note->title = str::trim($note->title);
            if ($note->title->empty()) {
                return .error(.refused(carbon::Refusal('a note needs a title')));
            }
        }
        return .ok();
    }

    public function after(carbon::Event $event, const Note& $note) : void
    {
        $this->trail->heard[] = "repo after {$event->value()}";
    }

    /**
     * A custom finder: pinned happy notes, newest first.
     */
    public function cheerful() : result<array<Note>, carbon::Error>
    {
        return $this->find()->pinned()->feeling(.happy)->newest()->get();
    }
}

/**
 * Switches a note repository is built with, shared by every one its factory builds.
 */
public class NoteFlags
{
    /**
     * Narrow every query to pinned notes.
     */
    public bool $pinnedOnly = false;
}
