namespace fixtures;

use std::time;

/**
 * Everything a test needs: the fake, the DB with every repository registered, its root session
 * and a repository of each model built for it, on a clock stopped at 2023-11-14 22:13:20 UTC.
 */
public class World
{
    public carbon::fake::Driver<hydrahon::Mysql> $fake;
    public carbon::DB $db;
    public carbon::Session $session;
    public calendar::ManualClock $clock;
    public NoteRepository $notes;
    public TagRepository $tags;
    public SettingRepository $settings;
    public ProfileRepository $profiles;
    public DraftRepository $drafts;
    public ShiftRepository $shifts;

    public constructor()
    {
        $this->fake = carbon::fake::Driver<hydrahon::Mysql>();
        $this->clock = calendar::ManualClock(time::timestamp::from_unix_secs(1700000000));
        $this->db = carbon::DB($this->fake, clock: $this->clock);
        Trail $trail = Trail();
        NoteFlags $flags = NoteFlags();
        guard $this->db->register<NoteRepository>(function[$trail, $flags](carbon::Session $s) : NoteRepository {
            return NoteRepository($s, $trail, $flags);
        });
        guard $this->db->register<SettingRepository>();
        guard Carbon::register($this->db);
        guard Carbon::check($this->db);
        $this->session = $this->db->session();
        NoteRepository $notes = guard $this->session->repo<NoteRepository>();
        $this->notes = $notes;
        TagRepository $tags = guard $this->session->repo<TagRepository>();
        $this->tags = $tags;
        SettingRepository $settings = guard $this->session->repo<SettingRepository>();
        $this->settings = $settings;
        ProfileRepository $profiles = guard $this->session->repo<ProfileRepository>();
        $this->profiles = $profiles;
        DraftRepository $drafts = guard $this->session->repo<DraftRepository>();
        $this->drafts = $drafts;
        ShiftRepository $shifts = guard $this->session->repo<ShiftRepository>();
        $this->shifts = $shifts;
    }
}
