namespace fixtures;

#[carbon::model: 'tags']
public class Tag : carbon::Model<Tag, TagRepository>
{
    public carbon::Link $link = .detached();

    #[carbon::key]
    public int64 $id = 0;
    public int64 $noteId;
    public string $name;

    #[carbon::belongsTo: 'noteId']
    public carbon::One<Note> $note = .unloaded();

    public function link() : carbon::Link&
    {
        return $this->link;
    }
}
