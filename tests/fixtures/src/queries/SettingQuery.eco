namespace fixtures;

/**
 * The query state's name, written the way carbongen writes one for a generated model.
 */
public type SettingRows = carbon::Rows<Setting, string, SettingTable>;

public struct SettingQuery : carbon::Query<Setting, SettingQuery>
{
    internal SettingRows $rows;

    public constructor(carbon::Session $session)
    {
        $this->rows = SettingRows($session);
    }

    public function rows() : SettingRows&
    {
        return $this->rows;
    }
}
