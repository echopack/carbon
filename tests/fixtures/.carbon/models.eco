/**
 * The `note` of a batch of `Tag` models, loaded with one query.
 */
public class TagNoteRelation : carbon::Eager<fixtures::Tag>
{
    internal carbon::relation::Fetch<fixtures::Note, fixtures::NoteQuery> $fetch;

    public constructor()
    {
        $this->fetch = carbon::relation::Fetch<fixtures::Note, fixtures::NoteQuery>();
    }

    /**
     * Start from `$base`, a query of the related model, for its conditions, order and scope.
     */
    public function from(fixtures::NoteQuery $base) : TagNoteRelation
    {
        $this->fetch->from($base);
        return $this;
    }

    public function where(hydrahon::Term<bool> $condition) : TagNoteRelation
    {
        $this->fetch->where($condition);
        return $this;
    }

    /**
     * Let `$constrain` change the related query before it runs: order, scope, its own scopes.
     */
    public function constrain(function<fixtures::NoteQuery(fixtures::NoteQuery)> $constrain) : TagNoteRelation
    {
        $this->fetch->constrain($constrain);
        return $this;
    }

    /**
     * Load `$relation` for the related models too, with one more query.
     */
    public function with(carbon::Eager<fixtures::Note> $relation) : TagNoteRelation
    {
        $this->fetch->with($relation);
        return $this;
    }

    public function load(array<fixtures::Tag>& $models, carbon::Connection $db) : status<carbon::Error>
    {
        carbon::relation::Keys<int64> $keys = carbon::relation::Keys<int64>();
        foreach ($models as const &$m) {
            $keys->add($m->noteId);
        }
        array<fixtures::Note> $found = [];
        if (!$keys->empty()) {
            fixtures::NoteQuery $q = $this->fetch->query($db, fixtures::NoteTable::$id in $keys->list());
            array<fixtures::Note> $rows = guard $q->get() else ($e) { return .error($e); }
            $found = mv $rows;
        }
        carbon::relation::Index<int64, fixtures::Note> $by = carbon::relation::Index<int64, fixtures::Note>();
        foreach ($found as const &$f) {
            $by->add($f->id, $f);
        }
        foreach ($models as &$m) {
            $m->note->set($by->first($m->noteId));
        }
        return .ok();
    }
}

/**
 * The relations of `Tag` models as `with…()` methods, for its query and its `load()`.
 * A query struct written by hand names it:
 * `TagQuery : carbon::Query<Tag, TagQuery>, TagRelations<TagQuery>`.
 */
public interface TagRelations<S>
{
    /**
     * Load the `note` of every model too, with one more query.
     */
    function withNote() : S
    {
        return $this->with(TagNoteRelation());
    }

    /**
     * Load the `note` of every model too, its query changed by `$constrain` first:
     * order, scope, and its own `with…()` for the relations of the related models.
     */
    function withNote(function<fixtures::NoteQuery(fixtures::NoteQuery)> $constrain) : S
    {
        return $this->with(TagNoteRelation()->constrain($constrain));
    }
}

/**
 * The relations to fill on `Tag` models already in hand:
 * `$repo->load()->with…()->into($models)`. It has no conditions or order; the models are
 * the ones given.
 */
public struct TagLoad : TagRelations<TagLoad>
{
    internal carbon::Fill<fixtures::Tag> $fill;

    public constructor(carbon::Connection $db)
    {
        $this->fill = carbon::Fill<fixtures::Tag>($db);
    }

    /**
     * Fill `$relation` too: what the `with…()` methods call, and where a relation written by
     * hand goes.
     */
    public function with(carbon::Eager<fixtures::Tag> $relation) : TagLoad
    {
        TagLoad $copy = $this;
        $copy->fill->add($relation);
        return $copy;
    }

    /**
     * Fill every relation asked for on `$models`, one query each.
     */
    public function into(array<fixtures::Tag>& $models) : status<carbon::Error>
    {
        return $this->fill->into($models);
    }
}

/**
 * `load()` for the repository of `Tag` models. A repository written by hand names it:
 * `TagRepository : carbon::Repository<Tag, …>, TagLoading`.
 */
public interface TagLoading
{
    /**
     * Start filling the relations of models already in hand.
     */
    function load() : TagLoad
    {
        return TagLoad($this->connection());
    }
}

/**
 * A column holding a `Mood`, compared and assigned with its cases.
 */
public struct MoodColumn
{
    /**
     * The column as hydrahon sees it, for anything else that takes a term.
     */
    public hydrahon::Term<int64> $term;

    /**
     * The condition that the column holds `$case`. The same as `==`, and the spelling to use
     * inside `&&` and `||`, where an operator of a generated type is not picked.
     */
    public const function is(fixtures::Mood $case) : hydrahon::Term<bool>
    {
        int64 $raw = $case->value() as int64;
        return $this->term == $raw;
    }

    /**
     * The condition that the column holds any of `$cases`.
     */
    public const function in(const array<fixtures::Mood>& $cases) : hydrahon::Term<bool>
    {
        array<int64> $raw = [];
        foreach ($cases as const &$v) {
            $raw[] = $v->value() as int64;
        }
        return $this->term in $raw;
    }

    /**
     * Ascending order on the column's stored value: `->order([PostTable::$status->asc()])`.
     */
    public const function asc() : hydrahon::Order
    {
        return $this->term->asc();
    }

    /**
     * Descending order on the column's stored value.
     */
    public const function desc() : hydrahon::Order
    {
        return $this->term->desc();
    }
}

operator (MoodColumn $column) == (fixtures::Mood $case) : hydrahon::Term<bool>
{
    return $column->is($case);
}

operator (MoodColumn $column) != (fixtures::Mood $case) : hydrahon::Term<bool>
{
    int64 $raw = $case->value() as int64;
    return $column->term != $raw;
}

operator (hydrahon::Values& $into)[const MoodColumn& $column] = (fixtures::Mood $case) : void
{
    int64 $raw = $case->value() as int64;
    $into[$column->term] = $raw;
}
