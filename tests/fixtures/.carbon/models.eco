    public static function register(carbon::DB $db) : status<carbon::Error>
    {
        guard $db->register<fixtures::DraftRepository>() else ($e) { return .error($e); }
        guard $db->register<fixtures::KitRepository>() else ($e) { return .error($e); }
        guard $db->register<fixtures::ProfileRepository>() else ($e) { return .error($e); }
        guard $db->register<fixtures::ShiftRepository>() else ($e) { return .error($e); }
        guard $db->register<fixtures::TagRepository>() else ($e) { return .error($e); }
        return .ok();
    }

    /**
     * Whether every repository these models need is registered on `$db`: their own, and the
     * ones their relations load through. Run it once after registering, so a repository left
     * out stops the app at startup, not on the first request that reaches it; the error names
     * every one left out. It also makes the store of every model, so none is made while
     * requests run.
     */
    public static function check(carbon::DB $db) : status<carbon::Error>
    {
        array<string> $missing = [];
        if (!$db->has<fixtures::DraftRepository>()) {
            $missing[] = 'fixtures::DraftRepository';
        }
        if (!$db->has<fixtures::KitRepository>()) {
            $missing[] = 'fixtures::KitRepository';
        }
        if (!$db->has<fixtures::NoteRepository>()) {
            $missing[] = 'fixtures::NoteRepository';
        }
        if (!$db->has<fixtures::TagRepository>()) {
            $missing[] = 'fixtures::TagRepository';
        }
        if (!$db->has<fixtures::ProfileRepository>()) {
            $missing[] = 'fixtures::ProfileRepository';
        }
        if (!$db->has<fixtures::ShiftRepository>()) {
            $missing[] = 'fixtures::ShiftRepository';
        }
        if ($missing->count() > 0) {
            return .error(.unregistered(str::join($missing, ', ')));
        }
        $db->store<fixtures::Draft, int64, fixtures::DraftTable>();
        $db->store<fixtures::Kit, int64, fixtures::KitTable>();
        $db->store<fixtures::Note, int64, fixtures::NoteTable>();
        $db->store<fixtures::Profile, int64, fixtures::ProfileTable>();
        $db->store<fixtures::Shift, int64, fixtures::ShiftTable>();
        $db->store<fixtures::Tag, int64, fixtures::TagTable>();
        return .ok();
    }
}
