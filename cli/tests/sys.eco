namespace carbongen;

test files_read_missing_as_empty_and_write_once
{
    string $dir = string::from(std::env::tmp());
    int32 $pid = std::env::pid();
    string $path = std::env::join($dir, "carbongen-sys-{$pid}.txt");
    assert(Sys::read($path) == '');
    assert(Sys::put($path, 'one'));
    assert(Sys::read($path) == 'one');
    // the same text again leaves the file alone and still answers true
    assert(Sys::put($path, 'one'));
    assert(Sys::put($path, 'two') && Sys::read($path) == 'two');
    guard std::io::remove($path);
}
