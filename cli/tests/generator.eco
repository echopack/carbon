namespace carbongen;

test a_manifest_is_wired_only_by_the_block_itself
{
    assert(Generator::wired("#[sources: \"src/*.eco\"]\n\n#[if: !CARBON_NOGEN]\n#[sources: \".carbon/*.eco\"]\n#[end]\n"));
    // the words alone, in a comment, do not leave .carbon/ out
    assert(!Generator::wired("// .carbon/ sits behind CARBON_NOGEN\n#[sources: \".carbon/*.eco\"]\n"));
    // nor does a block for another define
    assert(!Generator::wired("#[if: CARBON_NOGEN]\n#[sources: \".carbon/*.eco\"]\n#[end]\n"));
    // .carbon/ outside the block is compiled in the decls pass too
    assert(!Generator::wired("#[if: !CARBON_NOGEN]\n#[end]\n#[sources: \".carbon/*.eco\"]\n"));
}

test a_decls_format_that_moved_is_named
{
    json::Value $ok = guard json::parse('{"modules": [{"name": "m", "declarations": [{"kind": "class", "qualified": "a::B", "file": "f.eco", "line": 1, "tools": [], "conforms": [], "fields": []}]}]}');
    assert(Generator::unread($ok) == null);
    json::Value $moved = guard json::parse('{"modules": [{"name": "m", "declarations": [{"kind": "class", "qualified": "a::B", "file": "f.eco", "line": 1, "attributes": [], "conforms": [], "fields": []}]}]}');
    assert((Generator::unread($moved) ?? '') == 'tools');
    // no declarations at all is not a moved format
    json::Value $empty = guard json::parse('{"modules": [{"name": "m", "declarations": []}]}');
    assert(Generator::unread($empty) == null);
}

test the_module_name_comes_from_the_manifest
{
    string $blog = Generator::named("/* blog */\n#[module: \"blog\"]\n#[version: \"0.1.0\"]\n") ?? '';
    assert($blog == 'blog');
    string $shop = Generator::named("#[module: 'shop']\n") ?? '';
    assert($shop == 'shop');
    assert(Generator::named("#[version: \"0.1.0\"]\n") == null);
}

test a_whole_program_is_cut_down_to_the_module
{
    json::Value $all = guard json::parse('{"modules":[{"name":"stdlib","declarations":[{"kind":"struct"}]},{"name":"blog","declarations":[{"kind":"class"}]}]}');
    json::Value $local = guard Generator::only($all, 'blog');
    assert(json::dump($local) == '{"modules":[{"name":"blog","declarations":[{"kind":"class"}]}]}');
    assert(Generator::only($all, 'shop') == null);
}
