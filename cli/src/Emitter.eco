/**
 * Renders `.carbon/models.eco`: one table class per model, conforming to
 * `hydrahon::Source` and `carbon::Schema`, with every column as a static
 * (`PostTable::$title`), and a class for the table under an alias whose
 * fields are the columns (`PostTable::alias('p')->title`); the `PostRows`
 * alias a query keeps; the query and repository a module leaves out; the
 * `PostWiring` interface every repository names; one `carbon::Eager` class per
 * relation, the `PostRelations` interface of their `with…()` methods and the
 * `PostLoad` struct behind a repository's `load()`; a columns-only table class
 * per `#[carbon::table]`; and per namespace, `Carbon` to register and check it
 * all.
 */

namespace carbongen;

public struct Emitter
{
    public const Schema $schema;

    public const function render() : string
    {
        string $out = "// generated by carbongen from #[carbon::model] and #[carbon::table] declarations, do not edit\n";
        // types outside any namespace first, before a namespace statement claims the rest
        array<string> $spaces = [''];
        foreach ($this->schema->models as const &$m) {
            string $s = $m->space();
            bool $seen = false;
            foreach ($spaces as const &$known) {
                if ($known == $s) {
                    $seen = true;
                }
            }
            if (!$seen) {
                $spaces[] = $s;
            }
        }
        foreach ($spaces as const &$space) {
            bool $opened = false;
            foreach ($this->schema->models as const &$m) {
                if ($m->space() != $space) {
                    continue;
                }
                if (!$opened && $space->size() > 0) {
                    $out->append("\nnamespace {$space};\n");
                }
                $opened = true;
                if ($m->bare) {
                    $this->bare($m, $out);
                } else {
                    $this->model($m, $out);
                }
            }
            foreach ($this->schema->enumColumns($space) as const &$c) {
                $this->enumerated($c, $out);
            }
            $this->checks($space, $out);
        }
        return $out;
    }

    /**
     * The `Carbon` struct of namespace `$space`: `register($db)` for the repositories carbongen
     * wrote, and `check($db)`, which finds every repository its models need that is not
     * registered, at startup rather than on the first request that reaches it. Nothing when the
     * namespace has no model.
     */
    private const function checks(const string& $space, string& $out) : void
    {
        // every repository the namespace's models link to or load through, each once
        array<string> $repos = [];
        array<string> $written = [];
        array<string> $stores = [];
        foreach ($this->schema->models as const &$m) {
            if ($m->space() != $space || $m->bare) {
                continue;
            }
            Emitter::once($repos, $m->repository);
            if (!$m->repositoryDeclared) {
                $written[] = $m->repository;
            }
            $stores[] = "{$m->qualified}, {$m->key()->field()}, {$m->qualifiedHandle()}";
            foreach ($m->relations as const &$r) {
                Model $t = guard $this->schema->model($r->target);
                Emitter::once($repos, $t->repository);
            }
        }
        if ($stores->count() == 0) {
            return;
        }
        $out->append("\n/**\n * The wiring of the models of this namespace, registered and checked in one go.\n */\n");
        $out->append("public struct Carbon\n{\n");
        $out->append("    /**\n     * Register the repositories carbongen wrote for these models; the ones the module declares\n");
        $out->append("     * are registered by the app, with what they need.\n     */\n");
        $out->append("    public static function register(carbon::Db $db) : status<carbon::Error>\n    {\n");
        foreach ($written as const &$r) {
            $out->append("        guard $db->register<{$r}>() else ($e) { return .error($e); }\n");
        }
        $out->append("        return .ok();\n    }\n\n");
        $out->append("    /**\n     * Whether every repository these models need is registered on `$db`: their own, and the\n");
        $out->append("     * ones their relations load through. Run it once after registering, so a repository left\n");
        $out->append("     * out stops the app at startup, not on the first request that reaches it. It also makes\n");
        $out->append("     * the store of every model, so none is made while requests run.\n     */\n");
        $out->append("    public static function check(carbon::Db $db) : status<carbon::Error>\n    {\n");
        foreach ($repos as const &$r) {
            $out->append("        if (!$db->has<{$r}>()) {\n            return .error(.unregistered('{$r}'));\n        }\n");
        }
        foreach ($stores as const &$args) {
            $out->append("        $db->store<{$args}>();\n");
        }
        $out->append("        return .ok();\n    }\n}\n");
    }

    /**
     * Add `$name` to `$names` unless it is there already.
     */
    private static function once(array<string>& $names, const string& $name) : void
    {
        foreach ($names as const &$n) {
            if ($n == $name) {
                return;
            }
        }
        $names[] = $name;
    }

    /**
     * The column type of enum `$c->via`: compared and assigned with the enum's cases, so a
     * scope reads `PostTable::$status == Status::published`.
     */
    private const function enumerated(const Column& $c, string& $out) : void
    {
        string $class = $c->columnClass();
        string $e = $c->via;
        string $b = $c->base;
        string $local = Names::local($e);
        $out->append("\n/**\n * A column holding a `{$local}`, compared and assigned with its cases.\n */\n");
        $out->append("public struct {$class}\n{\n");
        $out->append("    /**\n     * The column as hydrahon sees it, for anything else that takes a term.\n     */\n");
        $out->append("    public hydrahon::Term<{$b}> $term;\n\n");
        $out->append("    /**\n     * The condition that the column holds `$case`. The same as `==`, and the spelling to use\n     * inside `&&` and `||`, where an operator of a generated type is not picked.\n     */\n");
        $out->append("    public const function is({$e} $case) : hydrahon::Term<bool>\n    {\n");
        $out->append("        {$b} $raw = $case->value() as {$b};\n        return $this->term == $raw;\n    }\n\n");
        $out->append("    /**\n     * The condition that the column holds any of `$cases`.\n     */\n");
        $out->append("    public const function in(const array<{$e}>& $cases) : hydrahon::Term<bool>\n    {\n");
        $out->append("        array<{$b}> $raw = [];\n");
        $out->append("        foreach ($cases as const &$v) {\n            $raw[] = $v->value() as {$b};\n        }\n");
        $out->append("        return $this->term in $raw;\n    }\n\n");
        $out->append("    /**\n     * Ascending order on the column's stored value: `->order([PostTable::$status->asc()])`.\n     */\n");
        $out->append("    public const function asc() : hydrahon::Order\n    {\n        return $this->term->asc();\n    }\n\n");
        $out->append("    /**\n     * Descending order on the column's stored value.\n     */\n");
        $out->append("    public const function desc() : hydrahon::Order\n    {\n        return $this->term->desc();\n    }\n}\n\n");
        $out->append("operator ({$class} $column) == ({$e} $case) : hydrahon::Term<bool>\n{\n    return $column->is($case);\n}\n\n");
        $out->append("operator ({$class} $column) != ({$e} $case) : hydrahon::Term<bool>\n{\n");
        $out->append("    {$b} $raw = $case->value() as {$b};\n    return $column->term != $raw;\n}\n\n");
        $out->append("operator (hydrahon::Values& $into)[const {$class}& $column] = ({$e} $case) : void\n{\n");
        $out->append("    {$b} $raw = $case->value() as {$b};\n    $into[$column->term] = $raw;\n}\n");
    }

    /**
     * The column statics, the slots, the table's constructor and `table()`, and `alias`: what a
     * model's table and a `#[carbon::table]` share.
     */
    private const function columns(const Model& $m, string& $out) : void
    {
        string $schema = '';
        if ($m->schema->size() > 0) {
            $schema = ", $schema: '{$m->schema}'";
        }
        string $aliased = $m->aliasClass();
        foreach ($m->columns as const &$c) {
            string $made = "carbon::select::column<{$c->term()}>('{$m->table}', '{$c->name}'{$schema})";
            if ($c->typed()) {
                $made = "{$c->columnClass()}({$made})";
            }
            $out->append("    public static {$c->declared()} ${$c->property} = {$made};\n");
        }
        foreach ($m->computed as const &$c) {
            $out->append("    public static carbon::select::Slot<{$c->base}> ${$c->property} = carbon::select::Slot<{$c->base}>('{$c->name}');\n");
        }
        $out->append("    private hydrahon::Table $carbonTable;\n\n");
        $out->append("    public constructor()\n    {\n");
        $out->append("        $this->carbonTable = hydrahon::Table(name: '{$m->table}'{$schema});\n    }\n\n");
        $out->append("    /**\n     * The table under `$alias`, to join it, or join it twice: `$p = {$m->handle()}::alias('p');`, then\n     * `$p->{$m->columns[0]->property}`. `$schema` names the database for a table that lives in\n     * another one.\n     */\n");
        $out->append("    public static function alias(string $alias, schema: string? $schema = {$m->schemaLiteral()}) : {$aliased}\n    {\n        return {$aliased}(alias: $alias, schema: $schema);\n    }\n\n");
        $out->append("    public const function table() : hydrahon::Table\n    {\n        return $this->carbonTable;\n    }\n");
    }

    /**
     * The class an aliased table is: its columns as fields, qualified by the alias.
     */
    private const function aliasClass(const Model& $m, string& $out) : void
    {
        string $named = Names::prose($m->table);
        string $class = $m->aliasClass();
        $out->append("\n/**\n * `{$named}` under an alias, from `{$m->handle()}::alias`.\n */\n");
        $out->append("public class {$class} : hydrahon::Source\n{\n");
        foreach ($m->columns as const &$c) {
            $out->append("    public const {$c->declared()} ${$c->property};\n");
        }
        $out->append("    private hydrahon::Table $carbonTable;\n\n");
        $out->append("    public constructor(alias: string $alias, schema: string? $schema = {$m->schemaLiteral()})\n    {\n");
        $out->append("        $this->carbonTable = hydrahon::Table(name: '{$m->table}', alias: $alias, $schema: $schema);\n    }\n\n");
        $out->append("    init\n    {\n");
        foreach ($m->columns as const &$c) {
            if ($c->typed()) {
                $out->append("        $this->{$c->property} = {$c->columnClass()}($this->carbonTable->column<{$c->term()}>('{$c->name}'));\n");
            } else {
                $out->append("        $this->{$c->property} = $this->carbonTable->column<{$c->term()}>('{$c->name}');\n");
            }
        }
        $out->append("    }\n\n");
        $out->append("    public const function table() : hydrahon::Table\n    {\n        return $this->carbonTable;\n    }\n}\n");
    }

    /**
     * A `#[carbon::table]`: its columns, nothing more.
     */
    private const function bare(const Model& $m, string& $out) : void
    {
        string $named = Names::prose($m->table);
        $out->append("\n/**\n * The columns of `{$named}`, to join and select from.\n */\n");
        $out->append("public class {$m->handle()} : hydrahon::Source\n{\n");
        $this->columns($m, $out);
        $out->append("}\n");
        $this->aliasClass($m, $out);
    }

    private const function model(const Model& $m, string& $out) : void
    {
        string $handle = $m->handle();
        string $model = $m->qualified;
        string $named = Names::prose($m->table);
        string $from = Names::local($m->qualified);
        const Column& $key = $m->key();
        string $k = $key->field();

        $out->append("\n/**\n * The columns of `{$named}` and how `{$from}` maps onto them.\n */\n");
        $out->append("public class {$handle} : hydrahon::Source, carbon::Schema<{$model}, {$k}>\n{\n");
        $this->columns($m, $out);
        $out->append("\n");

        $out->append("    public const function fields() : array<hydrahon::Field>\n    {\n");
        $out->append('        array<hydrahon::Field> $out = [');
        foreach ($m->columns as $i => const &$c) {
            if ($i > 0) {
                $out->append(', ');
            }
            $out->append($c->reach($handle));
        }
        $out->append("];\n        return $out;\n    }\n\n");

        $out->append("    public const function keyIs({$k} $key) : hydrahon::Term<bool>\n    {\n");
        $out->append("        return {$handle}::${$key->property} == $key;\n    }\n\n");
        $out->append("    public const function keyIn(const array<{$k}>& $keys) : hydrahon::Term<bool>\n    {\n");
        $out->append("        return {$handle}::${$key->property} in $keys;\n    }\n\n");
        $out->append("    public const function keyAfter({$k} $key) : hydrahon::Term<bool>\n    {\n");
        $out->append("        return {$handle}::${$key->property} > $key;\n    }\n\n");
        $out->append("    public const function byKey() : hydrahon::Order\n    {\n");
        $out->append("        return {$handle}::${$key->property}->asc();\n    }\n\n");
        if ($m->created->count() > 0) {
            $out->append("    public const function created() : hydrahon::Order?\n    {\n");
            $out->append("        return {$handle}::${$m->created[0]}->asc();\n    }\n\n");
        }
        $out->append("    public const function keyAt() : usize\n    {\n        return {$m->keyAt};\n    }\n\n");
        string $generated = 'false';
        if ($m->generated) {
            $generated = 'true';
        }
        $out->append("    public const function generated() : bool\n    {\n        return {$generated};\n    }\n\n");
        $out->append("    public const function keyOf(const {$model}& $m) : {$k}\n    {\n        return $m->{$key->property};\n    }\n\n");

        if ($m->computed->count() > 0) {
            $out->append("    public const function computed() : array<string>\n    {\n");
            $out->append('        array<string> $out = [');
            foreach ($m->computed as $j => const &$c) {
                if ($j > 0) {
                    $out->append(', ');
                }
                $out->append("'{$c->name}'");
            }
            $out->append("];\n        return $out;\n    }\n\n");
        }
        $this->read($m, $out);
        $this->snapshot($m, $out);
        $this->write($m, $out);

        $out->append("    public const function inserted({$model}& $m, int64 $key) : void\n    {\n");
        if ($m->generated) {
            if ($key->base == 'int64') {
                $out->append("        $m->{$key->property} = $key;\n");
            } else {
                $out->append("        $m->{$key->property} = $key as uint64;\n");
            }
        }
        $out->append("    }\n\n");

        $out->append("    public const function link({$model}& $m) : carbon::Link&\n    {\n");
        $out->append("        return $m->{$m->linkField};\n    }\n\n");

        $out->append("    public const function stamp({$model}& $m, carbon::Event $event, hydrahon::DateTime $now) : void\n    {\n");
        if ($m->created->count() > 0) {
            $out->append("        if ($event == carbon::Event::creating) {\n");
            foreach ($m->created as const &$p) {
                $out->append("            $m->{$p} = $now;\n");
            }
            $out->append("        }\n");
        }
        foreach ($m->updated as const &$p) {
            $out->append("        $m->{$p} = $now;\n");
        }
        $out->append("    }\n\n");

        $out->append("    public const function trash({$model}& $m, hydrahon::DateTime? $at) : bool\n    {\n");
        if ($m->deleted->size() > 0) {
            $out->append("        $m->{$m->deleted} = $at;\n        return true;\n");
        } else {
            $out->append("        return false;\n");
        }
        $out->append("    }\n\n");

        $out->append("    public const function trashed(const {$model}& $m) : hydrahon::DateTime?\n    {\n");
        if ($m->deleted->size() > 0) {
            $out->append("        return $m->{$m->deleted};\n");
        } else {
            $out->append("        return null;\n");
        }
        $out->append("    }\n\n");

        $out->append("    public const function live() : hydrahon::Term<bool>?\n    {\n");
        if ($m->deleted->size() > 0) {
            $out->append("        return {$handle}::${$m->deleted}->isNull();\n");
        } else {
            $out->append("        return null;\n");
        }
        $out->append('    }');
        if ($m->version->size() > 0) {
            Column $v = guard $m->column($m->version);
            $out->append("\n\n    public const function version(const {$model}& $m) : int64?\n    {\n");
            $out->append("        return $m->{$v->property} as int64;\n    }\n\n");
            $out->append("    public const function versionIs(int64 $version) : hydrahon::Term<bool>?\n    {\n");
            $out->append("        return {$handle}::${$v->property} == $version;\n    }\n\n");
            $out->append("    public const function revise({$model}& $m, int64 $version) : void\n    {\n");
            $out->append("        $m->{$v->property} = $version as {$v->inner};\n    }");
        }

        $out->append("\n}\n");
        $this->aliasClass($m, $out);
        $this->aliases($m, $out);
        foreach ($m->relations as const &$r) {
            $this->relation($m, $r, $out);
        }
        if ($m->relations->count() > 0) {
            $this->relations($m, $out);
            $this->load($m, $out);
        }
        $this->wiring($m, $out);
    }

    /**
     * The interface every repository of `$m` names: its session, the model's store and, with
     * relations, `load()`.
     */
    private const function wiring(const Model& $m, string& $out) : void
    {
        string $from = Names::local($m->qualified);
        string $iface = $m->wiringInterface();
        string $r = Names::local($m->repository);
        string $store = "carbon::Store<{$m->qualified}, {$m->key()->field()}, {$m->qualifiedHandle()}>";
        $out->append("\n/**\n * What a repository of `{$from}` models reaches through carbon: its session and the model's\n");
        $out->append(" * store. A repository written by hand names it and keeps its session in `$session`:\n");
        $out->append(" * `{$r} : carbon::Repository<{$from}, …>, {$iface}`.\n */\n");
        $out->append("public interface {$iface}\n{\n");
        $out->append("    /**\n     * The session the repository was built for.\n     */\n");
        $out->append("    function session() : carbon::Session\n    {\n        return $this->session;\n    }\n\n");
        $out->append("    /**\n     * The store of `{$from}` models, shared by every session.\n     */\n");
        $out->append("    function store() : {$store}\n    {\n");
        $out->append("        carbon::Session $s = $this->session();\n");
        $out->append("        return $s->store<{$m->qualified}, {$m->key()->field()}, {$m->qualifiedHandle()}>();\n    }\n");
        if ($m->relations->count() > 0) {
            string $load = $m->loadStruct();
            $out->append("\n    /**\n     * Start filling the relations of models already in hand.\n     */\n");
            $out->append("    function load() : {$load}\n    {\n        return {$load}($this->session());\n    }\n");
        }
        $out->append("}\n");
    }

    /**
     * The `with…()` methods of every relation of `$m`, for its query and its `load()`.
     */
    private const function relations(const Model& $m, string& $out) : void
    {
        string $from = Names::local($m->qualified);
        string $iface = $m->relationsInterface();
        string $q = Names::local($m->query);
        $out->append("\n/**\n * The relations of `{$from}` models as `with…()` methods, for its query and its `load()`.\n * A query struct written by hand names it:\n * `{$q} : carbon::Query<{$from}, {$q}>, {$iface}<{$q}>`.\n */\n");
        $out->append("public interface {$iface}<S>\n{\n");
        bool $first = true;
        foreach ($m->relations as const &$r) {
            Model $t = guard $this->schema->model($r->target);
            string $class = $m->relationClass($r);
            string $method = $m->relationMethod($r);
            if (!$first) {
                $out->append("\n");
            }
            $first = false;
            $out->append("    /**\n     * Load the `{$r->property}` of every model too, with one more query.\n     */\n");
            $out->append("    function {$method}() : S\n    {\n        return $this->with({$class}());\n    }\n\n");
            $out->append("    /**\n     * Load the `{$r->property}` of every model too, its query changed by `$constrain` first:\n     * order, scope, and its own `with…()` for the relations of the related models.\n     */\n");
            $out->append("    function {$method}(function<{$t->query}({$t->query})> $constrain) : S\n    {\n        return $this->with({$class}()->constrain($constrain));\n    }\n");
        }
        $out->append("}\n");
    }

    /**
     * What `load()` hands back for `$m`, and the interface that gives a repository `load()`.
     */
    private const function load(const Model& $m, string& $out) : void
    {
        string $from = Names::local($m->qualified);
        string $iface = $m->relationsInterface();
        string $load = $m->loadStruct();
        $out->append("\n/**\n * The relations to fill on `{$from}` models already in hand:\n * `$repo->load()->with…()->into($models)`. It has no conditions or order; the models are\n * the ones given.\n */\n");
        $out->append("public struct {$load} : {$iface}<{$load}>\n{\n");
        $out->append("    internal carbon::Fill<{$m->qualified}> $fill;\n\n");
        $out->append("    public constructor(carbon::Session $session)\n    {\n        $this->fill = carbon::Fill<{$m->qualified}>($session);\n    }\n\n");
        $out->append("    /**\n     * Fill `$relation` too: what the `with…()` methods call, and where a relation written by\n     * hand goes.\n     */\n");
        $out->append("    public function with(carbon::Eager<{$m->qualified}> $relation) : {$load}\n    {\n        {$load} $copy = $this;\n        $copy->fill->add($relation);\n        return $copy;\n    }\n\n");
        $out->append("    /**\n     * Fill every relation asked for on `$models`, one query each.\n     */\n");
        string $kf = $m->key()->field();
        $out->append("    public function into(array<{$m->qualified}>& $models) : status<carbon::Error>\n    {\n");
        $out->append("        // the models in hand are the load's first: relations back to them share them\n");
        $out->append("        carbon::Loaded $seen = carbon::Loaded();\n");
        $out->append("        foreach ($models as const &$m) {\n            $seen->add<{$kf}, {$m->qualified}>($m->{$m->key()->property}, $m);\n        }\n");
        $out->append("        return $this->fill->into($models, $seen);\n    }\n}\n");
    }

    private const function read(const Model& $m, string& $out) : void
    {
        $out->append("    public const function read(const carbon::Cursor& $row, const carbon::select::Selected& $extra) : result<{$m->qualified}, carbon::Error>\n    {\n");
        foreach ($m->columns as $i => const &$c) {
            string $name = "$c{$i}";
            if (!$c->nullable) {
                Emitter::value($c, "{$i}", "{$i}", $name, '        ', $out);
                continue;
            }
            $out->append("        {$c->field()} {$name} = null;\n");
            $out->append("        if (!$row->isNull({$i})) {\n");
            Emitter::value($c, "{$i}", "{$i}", "$v{$i}", '            ', $out);
            $out->append("            {$name} = $v{$i};\n");
            $out->append("        }\n");
        }
        string $made = "{$m->qualified}(";
        foreach ($m->columns as $i => const &$c) {
            if ($i > 0) {
                $made->append(', ');
            }
            $made->append("${$c->property}: $c{$i}");
        }
        $made->append(')');
        if ($m->computed->count() == 0) {
            $out->append("        return .ok({$made});\n    }\n\n");
            return;
        }
        $out->append("        {$m->qualified} $model = {$made};\n");
        foreach ($m->computed as $j => const &$c) {
            $out->append("        usize? $at{$j} = $extra->slot({$j});\n");
            $out->append("        if ($at{$j} != null) {\n");
            $out->append("            usize $p{$j} = guard $at{$j};\n");
            $out->append("            if (!$row->isNull($p{$j})) {\n");
            Emitter::value($c, "$p{$j}", "x{$j}", "$x{$j}", '                ', $out);
            $out->append("                $model->{$c->property} = $x{$j};\n");
            $out->append("            }\n");
            $out->append("        }\n");
        }
        $out->append("        return .ok($model);\n    }\n\n");
    }

    /**
     * Read the column at position `$at` (a number or a variable) into a new non-nullable
     * `$name` of the field's type, returning the column error when it does not fit. `$tag` keeps
     * the helper variables apart.
     */
    private static function value(const Column& $c, const string& $at, const string& $tag, const string& $name, const string& $pad, string& $out) : void
    {
        string $fail = "return .error(.column('{$c->name}', carbon::Problem::of($row, {$at})));";
        if ($c->shape == Shape::plain) {
            $out->append("{$pad}{$c->inner} {$name} = guard $row->{$c->reader()}({$at}) else { {$fail} }\n");
            return;
        }
        $out->append("{$pad}{$c->base} $r{$tag} = guard $row->{$c->reader()}({$at}) else { {$fail} }\n");
        if ($c->shape == Shape::codec) {
            $out->append("{$pad}{$c->inner} {$name} = guard {$c->via}()->decode($r{$tag}) else ($p) { return .error(.column('{$c->name}', $p)); }\n");
            return;
        }
        string $target = $c->inner;
        if ($c->shape == Shape::enumerated) {
            $target = $c->backing;
        }
        array<string> $bounds = Kinds::bounds($target);
        if ($bounds->count() == 2) {
            $out->append("{$pad}if ($r{$tag} < {$bounds[0]} || $r{$tag} > {$bounds[1]}) {\n");
            $out->append("{$pad}    return .error(.column('{$c->name}', .range));\n");
            $out->append("{$pad}}\n");
        }
        if ($c->shape == Shape::narrow) {
            $out->append("{$pad}{$c->inner} {$name} = $r{$tag} as {$c->inner};\n");
            return;
        }
        string $raw = "$r{$tag}";
        if ($target != $c->base) {
            $out->append("{$pad}{$target} $b{$tag} = $r{$tag} as {$target};\n");
            $raw = "$b{$tag}";
        }
        $out->append("{$pad}{$c->inner} {$name} = guard {$c->via}::from({$raw}) else { return .error(.column('{$c->name}', .unknown)); }\n");
    }

    /**
     * Declare `$s<at>` holding the column's stored value of model field `$m->property`.
     */
    private static function stored(const Column& $c, usize $at, const string& $pad, string& $out) : void
    {
        string $s = "$s{$at}";
        if ($c->shape == Shape::plain) {
            $out->append("{$pad}{$c->term()} {$s} = $m->{$c->property};\n");
            return;
        }
        if (!$c->nullable) {
            $out->append("{$pad}{$c->base} {$s} = ");
            $out->append(Emitter::widen($c, "$m->{$c->property}"));
            $out->append(";\n");
            return;
        }
        $out->append("{$pad}{$c->term()} {$s} = null;\n");
        $out->append("{$pad}if ($m->{$c->property} != null) {\n");
        $out->append("{$pad}    {$c->inner} $x{$at} = guard $m->{$c->property};\n");
        $out->append("{$pad}    {$s} = ");
        $out->append(Emitter::widen($c, "$x{$at}"));
        $out->append(";\n{$pad}}\n");
    }

    /**
     * `$value` (of the field's inner type) as the stored base type.
     */
    private static function widen(const Column& $c, const string& $value) : string
    {
        if ($c->shape == Shape::codec) {
            return "{$c->via}()->encode({$value})";
        }
        if ($c->shape == Shape::enumerated) {
            return "{$value}->value() as {$c->base}";
        }
        return "{$value} as {$c->base}";
    }

    private const function snapshot(const Model& $m, string& $out) : void
    {
        $out->append("    public const function snapshot(const {$m->qualified}& $m) : carbon::change::Snapshot\n    {\n");
        $out->append("        carbon::change::Snapshot $out = carbon::change::Snapshot();\n");
        foreach ($m->columns as $i => const &$c) {
            Emitter::stored($c, $i, '        ', $out);
            $out->append("        $out->values[] = hydrahon::Value::from($s{$i});\n");
        }
        $out->append("        return $out;\n    }\n\n");
    }

    private const function write(const Model& $m, string& $out) : void
    {
        $out->append("    public const function write(const {$m->qualified}& $m, const carbon::change::Changes& $only, hydrahon::Values& $into) : void\n    {\n");
        foreach ($m->columns as $i => const &$c) {
            $out->append("        if ($only->has({$i})) {\n");
            Emitter::stored($c, $i, '            ', $out);
            $out->append("            $into[{$c->reach($m->handle())}] = $s{$i};\n");
            $out->append("        }\n");
        }
        $out->append("    }\n\n");
    }

    /**
     * The query state's alias, and the query and repository the module did not declare.
     */
    private const function aliases(const Model& $m, string& $out) : void
    {
        string $from = Names::local($m->qualified);
        string $rows = $m->rowsAlias();
        string $k = $m->key()->field();
        $out->append("\n/**\n * What a query for `{$from}` models gathers: the field a query struct keeps.\n */\n");
        $out->append("public type {$rows} = carbon::Rows<{$m->rowsArgs()}>;\n");
        if (!$m->queryDeclared) {
            string $q = Names::local($m->query);
            $out->append("\n/**\n * A query for `{$from}` models. Declare a struct conforming to\n * `carbon::Query<{$from}, …>` in its place to give it scopes of its own.\n */\n");
            string $adopts = '';
            if ($m->relations->count() > 0) {
                $adopts = ", {$m->relationsInterface()}<{$q}>";
            }
            $out->append("public struct {$q} : carbon::Query<{$m->qualified}, {$q}>{$adopts}\n{\n");
            $out->append("    internal {$rows} $rows;\n\n");
            $out->append("    public constructor(carbon::Session $session)\n    {\n        $this->rows = {$rows}($session);\n    }\n\n");
            $out->append("    public function rows() : {$rows}&\n    {\n        return $this->rows;\n    }\n}\n");
        }
        if (!$m->repositoryDeclared) {
            string $r = Names::local($m->repository);
            $out->append("\n/**\n * The repository of `{$from}` models: writes and queries, nothing of its own. Declare a\n * struct conforming to `carbon::Repository<{$from}, …>` in its place for finders and hooks.\n */\n");
            $out->append("public struct {$r} : carbon::Repository<{$m->qualified}, {$m->query}, {$k}>, {$m->wiringInterface()}\n{\n");
            $out->append("    public carbon::Session $session;\n}\n");
        }
    }

    /**
     * The class of relation `$r`: its constraints and nested relations, and the loader that
     * fills the slot of a batch of models with one query.
     */
    private const function relation(const Model& $m, const Relation& $r, string& $out) : void
    {
        Model $t = guard $this->schema->model($r->target);
        string $class = $m->relationClass($r);
        string $tq = $t->query;
        string $th = $t->qualifiedHandle();
        string $from = Names::local($m->qualified);
        $out->append("\n/**\n * The `{$r->property}` of a batch of `{$from}` models, loaded with one query.\n */\n");
        $out->append("public class {$class} : carbon::Eager<{$m->qualified}>\n{\n");
        string $fetch = "carbon::relation::Fetch<{$t->qualified}, {$tq}, {$t->repository}>";
        $out->append("    internal {$fetch} $fetch;\n\n");
        $out->append("    public constructor()\n    {\n        $this->fetch = {$fetch}('{$t->repository}');\n    }\n\n");
        $out->append("    /**\n     * Start from `$base`, a query of the related model, for its conditions, order and scope.\n     */\n");
        $out->append("    public function from({$tq} $base) : {$class}\n    {\n        $this->fetch->from($base);\n        return $this;\n    }\n\n");
        $out->append("    public function where(hydrahon::Term<bool> $condition) : {$class}\n    {\n        $this->fetch->where($condition);\n        return $this;\n    }\n\n");
        $out->append("    /**\n     * Let `$constrain` change the related query before it runs: order, scope, its own scopes.\n     */\n");
        $out->append("    public function constrain(function<{$tq}({$tq})> $constrain) : {$class}\n    {\n        $this->fetch->constrain($constrain);\n        return $this;\n    }\n\n");
        $out->append("    /**\n     * Load `$relation` for the related models too, with one more query.\n     */\n");
        $out->append("    public function with(carbon::Eager<{$t->qualified}> $relation) : {$class}\n    {\n        $this->fetch->with($relation);\n        return $this;\n    }\n\n");
        $out->append("    public function load(array<{$m->qualified}>& $models, carbon::Session $session, carbon::Loaded $seen) : status<carbon::Error>\n    {\n");
        // the key each model of the batch is matched on: its own foreign key or its key
        string $kt = '';
        string $picks = '';
        string $by = '';
        string $own = "$m->{$m->key()->property}";
        // a nullable key on the related model: rows without it belong to no model of the batch
        bool $loose = false;
        if ($r->direction == Direction::belongsTo) {
            const Column& $tk = $t->key();
            $kt = $tk->field();
            $picks = "{$th}::${$tk->property} in $keys->list()";
            $by = "$f->{$tk->property}";
            $own = "$m->{$r->foreign}";
        } else {
            $kt = $m->key()->field();
            $picks = "{$th}::${$r->foreign} in $keys->list()";
            $by = "$f->{$r->foreign}";
            Column $fk = guard $t->column($r->foreign);
            $loose = $fk->nullable;
        }
        string $take = 'first';
        if ($r->direction == Direction::hasMany) {
            $take = 'all';
        }
        bool $optional = $m->optional($r);
        bool $belongs = $r->direction == Direction::belongsTo;
        bool $one = $r->direction != Direction::hasMany;
        string $tt = $t->qualified;
        const Column& $pk = $t->key();
        string $pkt = $pk->field();
        string $seen = "$seen->find<{$kt}, {$tt}>";
        if ($one) {
            // only a relation nothing narrows may hand out a model the load read for another
            $out->append("        bool $reuse = $this->fetch->plain();\n");
        }
        $out->append("        carbon::relation::Keys<{$kt}> $keys = carbon::relation::Keys<{$kt}>();\n");
        $out->append("        foreach ($models as const &$m) {\n");
        string $key = $own;
        string $pad = '            ';
        if ($optional) {
            $out->append("            if ({$own} != null) {\n");
            $out->append("                {$kt} $k = guard {$own};\n");
            $key = '$k';
            $pad = '                ';
        }
        if ($belongs) {
            // a model this load holds already needs no row read again
            // bound first: echoc never lets go of a model compared with null where it is returned
            $out->append("{$pad}{$tt}? $held = null;\n");
            $out->append("{$pad}if ($reuse) {\n{$pad}    $held = {$seen}({$key});\n{$pad}}\n");
            $out->append("{$pad}if ($held == null) {\n{$pad}    $keys->add({$key});\n{$pad}}\n");
        } else {
            $out->append("{$pad}$keys->add({$key});\n");
        }
        if ($optional) {
            $out->append("            }\n");
        }
        $out->append("        }\n");
        $out->append("        array<{$tt}> $found = [];\n");
        $out->append("        if (!$keys->empty()) {\n");
        $out->append("            {$tq} $q = guard $this->fetch->query($session, {$picks}, $seen) else ($e) { return .error($e); }\n");
        $out->append("            array<{$tt}> $rows = guard $q->get() else ($e) { return .error($e); }\n");
        $out->append("            $found = mv $rows;\n");
        $out->append("        }\n");
        $out->append("        carbon::relation::Index<{$kt}, {$tt}> $by = carbon::relation::Index<{$kt}, {$tt}>();\n");
        if ($one && !$belongs) {
            $out->append("        carbon::relation::Index<{$kt}, {$tt}> $known = carbon::relation::Index<{$kt}, {$tt}>();\n");
        }
        $out->append("        foreach ($found as const &$f) {\n");
        $out->append("            {$tt}? $had = $seen->find<{$pkt}, {$tt}>($f->{$pk->property});\n");
        string $at = $by;
        $pad = '            ';
        if ($loose) {
            $out->append("            if ({$by} != null) {\n");
            $out->append("                {$kt} $k = guard {$by};\n");
            $at = '$k';
            $pad = '                ';
        }
        string $keep = "{$pad}$by->add({$at}, $f);\n{$pad}if ($had == null) {\n{$pad}    $seen->add<{$pkt}, {$tt}>($f->{$pk->property}, $f);\n{$pad}}\n";
        if ($one && !$belongs) {
            $out->append("{$pad}if ($reuse && $had != null) {\n");
            $out->append("{$pad}    {$tt} $h = guard $had;\n");
            $out->append("{$pad}    $known->add({$at}, $h);\n");
            $out->append("{$pad}} else {\n");
            $out->append("{$pad}    $by->add({$at}, $f);\n{$pad}    if ($had == null) {\n{$pad}        $seen->add<{$pkt}, {$tt}>($f->{$pk->property}, $f);\n{$pad}    }\n");
            $out->append("{$pad}}\n");
        } else {
            $out->append($keep);
        }
        if ($loose) {
            $out->append("            }\n");
        }
        $out->append("        }\n");
        $out->append("        foreach ($models as &$m) {\n");
        if (!$one) {
            $out->append("            $m->{$r->property}->set($by->all({$own}));\n");
        } else {
            if ($optional) {
                $out->append("            if ({$own} == null) {\n                $m->{$r->property}->set(null);\n                continue;\n            }\n");
                $out->append("            {$kt} $k = guard {$own};\n");
            } else {
                $out->append("            {$kt} $k = {$own};\n");
            }
            $out->append("            {$tt}? $fresh = $by->first($k);\n");
            $out->append("            if ($fresh != null) {\n                $m->{$r->property}->set($fresh);\n                continue;\n            }\n");
            if ($belongs) {
                $out->append("            {$tt}? $shared = null;\n");
                $out->append("            if ($reuse) {\n                $shared = {$seen}($k);\n            }\n");
            } else {
                $out->append("            {$tt}? $shared = $known->first($k);\n");
            }
            $out->append("            if ($shared != null) {\n                {$tt} $s = guard $shared;\n                $m->{$r->property}->share($s);\n            } else {\n                $m->{$r->property}->set(null);\n            }\n");
        }
        $out->append("        }\n");
        $out->append("        return .ok();\n    }\n}\n");
    }
}
