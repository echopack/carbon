/**
 * The #[carbon::model] classes of a module, read from its decls JSON and
 * checked. Every misuse becomes a `file:line` problem; nothing is guessed.
 */

namespace carbongen;

public class Schema
{
    public array<Model> $models = [];
    public array<string> $problems = [];
    // every declaration by qualified name, to look up enums, codecs, clashes and the models
    // relations point to, known before any is read so relations can point forward
    private map<string, json::Value> $declared = [];

    public static function read(const json::Value& $decls) : Schema
    {
        Schema $s = Schema();
        foreach (Json::items($decls, 'modules') as const &$m) {
            foreach (Json::items($m, 'declarations') as const &$d) {
                string $q = Json::text($d, 'qualified');
                $s->declared[$q] = $d;
            }
        }
        foreach (Json::items($decls, 'modules') as const &$m) {
            foreach (Json::items($m, 'declarations') as const &$d) {
                $s->declaration($d);
            }
        }
        if ($s->problems->count() == 0) {
            $s->relate();
            $s->enumNames();
        }
        return $s;
    }

    /**
     * The enum column types to generate in namespace `$space`, one per enum, as columns that
     * name them.
     */
    public const function enumColumns(const string& $space) : array<Column>
    {
        array<Column> $out = [];
        foreach ($this->models as const &$m) {
            if ($m->space() != $space) {
                continue;
            }
            foreach ($m->columns as const &$c) {
                if (!$c->typed()) {
                    continue;
                }
                bool $seen = false;
                foreach ($out as const &$o) {
                    if ($o->via == $c->via) {
                        $seen = true;
                    }
                }
                if (!$seen) {
                    $out[] = $c;
                }
            }
        }
        return $out;
    }

    public const function model(const string& $qualified) : Model?
    {
        foreach ($this->models as const &$m) {
            if ($m->qualified == $qualified) {
                return $m;
            }
        }
        return null;
    }

    private function declaration(const json::Value& $d) : void
    {
        string $kind = Json::text($d, 'kind');
        string $q = Json::text($d, 'qualified');
        string $at = Schema::where($d, Json::int($d, 'line'));
        if (Json::has($d, 'table')) {
            $this->bare($d, $kind, $q, $at);
            return;
        }
        if (!Json::has($d, 'model')) {
            if (Json::tools($d)->count() > 0) {
                $this->problem("{$at}: {$q}: #[carbon::...] needs #[carbon::model] or #[carbon::table] on the same type");
            }
            foreach (Json::items($d, 'fields') as const &$f) {
                if (Json::tools($f)->count() > 0) {
                    string $fat = Schema::where($d, Json::int($f, 'line'));
                    $this->problem("{$fat}: {$q}: field attributes need #[carbon::model] on the type");
                }
            }
            return;
        }
        if ($kind != 'class') {
            $this->problem("{$at}: {$q}: #[carbon::model] belongs on a class");
            return;
        }
        $this->known($d, ['model', 'schema', 'columns'], $at, $q);
        if (Json::items($d, 'generics')->count() > 0) {
            $this->problem("{$at}: {$q}: a model cannot be generic, its table maps one type");
            return;
        }
        string $table = Json::tool($d, 'model');
        if (!Names::literal($table)) {
            $this->problem("{$at}: {$q}: #[carbon::model] needs the table name: #[carbon::model: 'posts']");
            return;
        }
        string $schema = Json::tool($d, 'schema');
        if (Json::has($d, 'schema') && !Names::literal($schema)) {
            $this->problem("{$at}: {$q}: #[carbon::schema] needs a name");
        }
        bool $snake = $this->snake($d, $at, $q);
        if (Json::items($d, 'constructors')->count() > 0) {
            $this->problem("{$at}: {$q}: a model keeps the implicit constructor, carbon builds it field by field");
        }

        Model $model = Model($q, $table, $schema, '', '', [], 0, false, [], [], '', []);
        int32 $keys = 0;
        // where the key is declared, and the field named id for the key it becomes when none is marked
        string $keyFat = '';
        string $keyWhat = '';
        string $idAt = '';
        string $idWhat = '';
        array<string> $tools = ['key', 'name', 'skip', 'created', 'updated', 'deleted', 'codec', 'computed', 'belongsTo', 'hasOne', 'hasMany'];
        array<string> $relating = ['belongsTo', 'hasOne', 'hasMany'];
        foreach (Json::items($d, 'fields') as const &$f) {
            string $field = Json::text($f, 'name');
            string $what = "{$q}::${$field}";
            string $fat = Schema::where($d, Json::int($f, 'line'));
            $this->known($f, $tools, $fat, $what);
            if (Json::flag($f, 'static')) {
                $this->idle($f, $tools, [], 'on a static field, which is no column', $fat, $what);
                continue;
            }
            json::Value $type = Json::field($f, 'type');
            bool $defaulted = Json::flag($f, 'default');
            bool $fixed = Json::flag($type, 'const');
            bool $hidden = Json::text($f, 'visibility') == 'private';

            string $repo = Types::argument($type, 'carbon::Link');
            if ($repo->size() == 0 && Json::text($type, 'kind') == 'named' && Json::text($type, 'name') == 'unknown' && Json::text($f, 'default_value') == '.detached()') {
                // a link to the repository carbongen writes, which echoc cannot name yet
                $repo = $model->qualify($model->repositoryAlias());
            }
            if ($repo->size() > 0) {
                if ($model->linkField->size() > 0) {
                    $this->problem("{$fat}: {$what}: a model has one carbon::Link");
                }
                $model->linkField = $field;
                $model->repository = $repo;
                $this->idle($f, $tools, [], 'on the carbon::Link field', $fat, $what);
                if ($fixed || $hidden) {
                    $this->problem("{$fat}: {$what}: the link cannot be const or private, carbon keeps the state of the model in it");
                }
                $this->defaulted($defaulted, $fat, $what);
                continue;
            }
            if ($this->slot($type, $f, $fat, $what, $model)) {
                $this->idle($f, $tools, $relating, 'on a relation slot', $fat, $what);
                if ($fixed || $hidden) {
                    $this->problem("{$fat}: {$what}: a relation slot cannot be const or private, its loader fills it");
                }
                $this->defaulted($defaulted, $fat, $what);
                continue;
            }
            if (Json::has($f, 'skip')) {
                // a relation attribute here was reported by slot() already
                array<string> $kept = ['skip', 'belongsTo', 'hasOne', 'hasMany'];
                $this->idle($f, $tools, $kept, 'beside #[carbon::skip]', $fat, $what);
                $this->defaulted($defaulted, $fat, $what);
                continue;
            }
            string $name = guard $this->columnName($f, $field, $snake, $fat, $what) else {
                continue;
            }
            Column $c = guard $this->column($type, $f, $field, $name, Names::space($q), $fat, $what) else {
                continue;
            }
            $c->fixed = $fixed;
            if (Json::has($f, 'computed')) {
                if (Json::has($f, 'key') || Json::has($f, 'created') || Json::has($f, 'updated') || Json::has($f, 'deleted') || $c->shape == Shape::codec) {
                    $this->problem("{$fat}: {$what}: a computed field is only read: no key, timestamp or codec");
                    continue;
                }
                if ($fixed) {
                    $this->problem("{$fat}: {$what}: a computed field cannot be const, carbon fills it after the columns");
                    continue;
                }
                if (!$c->nullable && !$defaulted) {
                    $this->problem("{$fat}: {$what}: a computed field is only there when a query selects it, so it needs to be nullable or have a default");
                    continue;
                }
                $this->taken($model->computed, $name, $fat, $what);
                $model->computed[] = $c;
                continue;
            }
            $this->taken($model->columns, $name, $fat, $what);
            if (Json::has($f, 'key')) {
                $keys = $keys + 1;
                $keyFat = $fat;
                $keyWhat = $what;
                $model->keyAt = $model->columns->count();
                string $mode = Json::tool($f, 'key');
                if ($mode->size() > 0 && $mode != 'assigned') {
                    $this->problem("{$fat}: {$what}: #[carbon::key] takes nothing, or assigned for a key the app sets");
                }
                $this->keyable($c, $fat, $what);
                $model->generated = $mode->size() == 0 && $c->base != 'string';
            }
            if ($field == 'id') {
                $idAt = $fat;
                $idWhat = $what;
            }
            $this->stamps($f, $c, $fat, $what, $model);
            $model->columns[] = $c;
        }

        if ($model->linkField->size() == 0) {
            $this->problem("{$at}: {$q}: a model needs a carbon::Link<Repository> field: public carbon::Link<PostRepository> $link = .detached();");
        }
        if ($keys == 0) {
            // a column named id is the key when nothing is marked
            usize $i = 0;
            while ($i < $model->columns->count()) {
                if ($model->columns[$i]->property == 'id') {
                    $keys = 1;
                    $keyFat = $idAt;
                    $keyWhat = $idWhat;
                    $model->keyAt = $i;
                    $model->generated = $model->columns[$i]->base != 'string';
                    $this->keyable($model->columns[$i], $idAt, $idWhat);
                }
                $i = $i + 1;
            }
        }
        if ($keys == 0) {
            $this->problem("{$at}: {$q}: no key; mark one field #[carbon::key]");
        } else if ($keys > 1) {
            $this->problem("{$at}: {$q}: one key per model, {$keys} are marked");
        } else if ($model->generated && $model->columns[$model->keyAt]->fixed) {
            $this->problem("{$keyFat}: {$keyWhat}: a key the database generates cannot be const, carbon sets it after the insert; drop const or mark it #[carbon::key: 'assigned']");
        }
        if ($model->columns->count() == 0) {
            $this->problem("{$at}: {$q}: #[carbon::model] without a single column");
            return;
        }
        $this->query($model);
        $model->repositoryDeclared = $this->declared->has($model->repository);
        array<string> $generated = [$model->qualifiedHandle(), $model->qualify($model->aliasClass()), $model->qualify($model->rowsAlias())];
        if (!$model->queryDeclared) {
            $generated[] = $model->query;
        }
        if ($model->relations->count() > 0) {
            $generated[] = $model->qualify($model->relationsInterface());
            $generated[] = $model->qualify($model->loadStruct());
            $generated[] = $model->qualify($model->loadingInterface());
        }
        if (!$model->repositoryDeclared && $model->repository->size() > 0) {
            if (Names::space($model->repository) != $model->space()) {
                $this->problem("{$at}: {$q}: {$model->repository} is not declared; declare it, or name one in {$model->space()} for carbongen to write");
                return;
            }
        }
        foreach ($generated as const &$name) {
            if ($this->declared->has($name)) {
                $this->problem("{$at}: {$q}: the generated {$name} would clash with the declaration of that name");
                return;
            }
        }
        foreach ($this->models as const &$other) {
            if (!$other->bare && $model->repository->size() > 0 && $other->repository == $model->repository) {
                $this->problem("{$at}: {$q}: {$model->repository} already keeps the {$other->qualified} models; a repository keeps one model");
                return;
            }
        }
        $this->models[] = $model;
    }

    /**
     * Report a key column that is not a plain, non-null int64, uint64 or string: the shapes
     * `keyIs`, `inserted` and `Keys<K>` are written for.
     */
    private function keyable(const Column& $c, const string& $fat, const string& $what) : void
    {
        if ($c->nullable || $c->shape != Shape::plain || ($c->base != 'int64' && $c->base != 'uint64' && $c->base != 'string')) {
            $this->problem("{$fat}: {$what}: a key is int64, uint64 or string");
        }
    }

    /**
     * Find the module's query for `$model`: the one declaration conforming to
     * `carbon::Query<Model, …>`, or the name carbongen writes one under.
     */
    private function query(Model& $model) : void
    {
        foreach ($this->declared as $name => const &$d) {
            foreach (Json::items($d, 'conforms') as const &$c) {
                if (Json::text($c, 'name') != 'carbon::Query') {
                    continue;
                }
                array<json::Value> $args = Json::items($c, 'args');
                if ($args->count() == 2 && Types::render($args[0]) == $model->qualified) {
                    if ($model->queryDeclared) {
                        $this->problem("{$model->qualified}: two queries conform to carbon::Query<{$model->qualified}, …>: {$model->query} and {$name}");
                    }
                    $model->query = $name;
                    $model->queryDeclared = true;
                }
            }
        }
        if (!$model->queryDeclared) {
            $model->query = $model->qualify($model->queryStruct());
        }
    }

    /**
     * Whether a type's columns are named in snake_case: the default, unless
     * `#[carbon::columns: exact]` keeps the field names.
     */
    private function snake(const json::Value& $d, const string& $at, const string& $q) : bool
    {
        if (!Json::has($d, 'columns')) {
            return true;
        }
        string $columns = Json::tool($d, 'columns');
        if ($columns == 'snake') {
            return true;
        }
        if ($columns == 'exact') {
            return false;
        }
        $this->problem("{$at}: {$q}: #[carbon::columns] is snake (the default) or exact");
        return true;
    }

    /**
     * Read a `#[carbon::table]`: a table the app joins and selects from but keeps no model of,
     * a pivot or a cache. Only its columns are generated.
     */
    private function bare(const json::Value& $d, const string& $kind, const string& $q, const string& $at) : void
    {
        if ($kind != 'struct' && $kind != 'class') {
            $this->problem("{$at}: {$q}: #[carbon::table] belongs on a struct or a class");
            return;
        }
        if (Json::has($d, 'model')) {
            $this->problem("{$at}: {$q}: #[carbon::table] and #[carbon::model] do not mix; a model already has its table");
            return;
        }
        $this->known($d, ['table', 'schema', 'columns'], $at, $q);
        string $table = Json::tool($d, 'table');
        if (!Names::literal($table)) {
            $this->problem("{$at}: {$q}: #[carbon::table] needs the table name: #[carbon::table: 'movie_genres']");
            return;
        }
        string $schema = Json::tool($d, 'schema');
        if (Json::has($d, 'schema') && !Names::literal($schema)) {
            $this->problem("{$at}: {$q}: #[carbon::schema] needs a name");
        }
        bool $snake = $this->snake($d, $at, $q);
        Model $model = Model($q, $table, $schema, '', '', [], 0, false, [], [], '', []);
        $model->bare = true;
        array<string> $tools = ['name', 'skip'];
        foreach (Json::items($d, 'fields') as const &$f) {
            string $field = Json::text($f, 'name');
            string $what = "{$q}::${$field}";
            string $fat = Schema::where($d, Json::int($f, 'line'));
            $this->known($f, $tools, $fat, $what);
            if (Json::flag($f, 'static')) {
                $this->idle($f, $tools, [], 'on a static field, which is no column', $fat, $what);
                continue;
            }
            if (Json::has($f, 'skip')) {
                array<string> $kept = ['skip'];
                $this->idle($f, $tools, $kept, 'beside #[carbon::skip]', $fat, $what);
                continue;
            }
            string $name = guard $this->columnName($f, $field, $snake, $fat, $what) else {
                continue;
            }
            Column $c = guard $this->column(Json::field($f, 'type'), $f, $field, $name, Names::space($q), $fat, $what) else {
                continue;
            }
            $this->taken($model->columns, $name, $fat, $what);
            $model->columns[] = $c;
        }
        if ($model->columns->count() == 0) {
            $this->problem("{$at}: {$q}: #[carbon::table] without a single column");
            return;
        }
        foreach ([$model->qualifiedHandle(), $model->qualify($model->aliasClass())] as const &$name) {
            if ($this->declared->has($name)) {
                $this->problem("{$at}: {$q}: the generated {$name} would clash with the declaration of that name");
                return;
            }
        }
        $this->models[] = $model;
    }

    /**
     * The column name of field `$f`: snake_case unless the type keeps names exact, or its
     * `#[carbon::name]`. Null after a problem: a private field, the reserved name, or a name
     * that is no literal.
     */
    private function columnName(const json::Value& $f, const string& $field, bool $snake, const string& $fat, const string& $what) : string?
    {
        if (Json::text($f, 'visibility') == 'private') {
            $this->problem("{$fat}: {$what}: a column cannot be private, carbon reads and writes it");
            return null;
        }
        if ($field == RESERVED) {
            $this->problem("{$fat}: {$what}: the generated table keeps its hydrahon table in this name; rename the field or mark it #[carbon::skip]");
            return null;
        }
        string $name = $field;
        if ($snake) {
            $name = Names::snake($field);
        }
        if (Json::has($f, 'name')) {
            $name = Json::tool($f, 'name');
            if (!Names::literal($name)) {
                $this->problem("{$fat}: {$what}: #[carbon::name] needs a column name");
                return null;
            }
        }
        return $name;
    }

    /**
     * Report column `$name` when one of `$columns`, the columns or the computed fields read so
     * far, already has it.
     */
    private function taken(const array<Column>& $columns, const string& $name, const string& $fat, const string& $what) : void
    {
        foreach ($columns as const &$other) {
            if ($other->name == $name) {
                $this->problem("{$fat}: {$what}: column '{$name}' is already taken by ${$other->property}");
            }
        }
    }

    /**
     * Read a relation slot. False when the field is no slot.
     */
    private function slot(const json::Value& $type, const json::Value& $f, const string& $at, const string& $what, Model& $model) : bool
    {
        string $one = Types::argument($type, 'carbon::One');
        string $many = Types::argument($type, 'carbon::Many');
        if ($one->size() == 0 && $many->size() == 0) {
            if (Direction::marked($f)->count() > 0) {
                $this->problem("{$at}: {$what}: a relation goes on a carbon::One<T> or carbon::Many<T> field");
            }
            return false;
        }
        string $field = Json::text($f, 'name');
        string $target = $one;
        if ($many->size() > 0) {
            $target = $many;
        }
        if (!$this->declared->has($target) || !Json::has($this->declared->get($target), 'model')) {
            $this->problem("{$at}: {$what}: {$target} is not a #[carbon::model] of this module");
            return true;
        }
        array<Direction> $marks = Direction::marked($f);
        if ($marks->count() == 0) {
            $this->problem("{$at}: {$what}: a relation slot needs #[carbon::belongsTo], #[carbon::hasOne] or #[carbon::hasMany]");
            return true;
        }
        if ($marks->count() > 1) {
            $this->problem("{$at}: {$what}: one relation per slot");
            return true;
        }
        Direction $d = $marks[0];
        string $foreign = Json::tool($f, $d->tool());
        if ($foreign->size() == 0) {
            $this->problem("{$at}: {$what}: name the key field: #[carbon::belongsTo: 'authorId']");
            return true;
        }
        if ($d == Direction::hasMany && $many->size() == 0) {
            $this->problem("{$at}: {$what}: #[carbon::hasMany] fills a carbon::Many<T>");
            return true;
        }
        if ($d != Direction::hasMany && $one->size() == 0) {
            $this->problem("{$at}: {$what}: #[carbon::belongsTo] and #[carbon::hasOne] fill a carbon::One<T>");
            return true;
        }
        $model->relations[] = Relation($field, $d, $target, $foreign);
        return true;
    }

    /**
     * Read a column, or report why the field has none.
     */
    private function column(const json::Value& $type, const json::Value& $f, const string& $field, const string& $name, const string& $space, const string& $at, const string& $what) : Column?
    {
        bool $nullable = Json::text($type, 'kind') == 'optional';
        json::Value $inner = $type;
        if ($nullable) {
            $inner = Json::field($type, 'of');
        }
        string $innerText = Types::render($inner);
        if (Json::has($f, 'codec')) {
            string $named = Json::tool($f, 'codec');
            if (Codecs::known($named)) {
                string $builtin = Codecs::builtin($named, $innerText);
                if ($builtin->size() == 0) {
                    string $stores = Codecs::stores($named);
                    $this->problem("{$at}: {$what}: the {$named} codec stores {$stores}, not {$innerText}; write a carbon::Codec<{$innerText}, Raw> for it");
                    return null;
                }
                return Column($field, $name, $innerText, $nullable, 'string', .codec, $builtin, '');
            }
            string $via = guard $this->codec($named, $space) else {
                $this->problem("{$at}: {$what}: #[carbon::codec] names '{$named}', which is neither one of carbon's (json, csv, lines) nor declared in this module");
                return null;
            }
            string $raw = $this->raw($via, $innerText);
            if ($raw->size() == 0) {
                $this->problem("{$at}: {$what}: {$via} has to conform to carbon::Codec<{$innerText}, Raw> with Raw a column type such as string or int64");
                return null;
            }
            return Column($field, $name, $innerText, $nullable, $raw, .codec, $via, '');
        }
        if (Kinds::plain($innerText)) {
            return Column($field, $name, $innerText, $nullable, $innerText, .plain, '', '');
        }
        string $wide = Kinds::widened($innerText);
        if ($wide->size() > 0) {
            return Column($field, $name, $innerText, $nullable, $wide, .narrow, '', '');
        }
        if ($this->declared->has($innerText)) {
            json::Value $e = $this->declared->get($innerText);
            if (Json::text($e, 'kind') == 'enum') {
                json::Value $backing = Json::field($e, 'backing');
                string $b = Types::render($backing);
                if (Json::text($backing, 'kind') == 'prim' && $b != 'bool' && $b != 'float32' && $b != 'float64') {
                    string $base = 'int64';
                    if ($b == 'uint64') {
                        $base = 'uint64';
                    }
                    return Column($field, $name, $innerText, $nullable, $base, .enumerated, $innerText, $b);
                }
                $this->problem("{$at}: {$what}: an enum column needs an integer backing: enum {$innerText} : uint8");
                return null;
            }
        }
        $this->problem("{$at}: {$what}: no column type for {$innerText}; add #[carbon::codec: 'json'] (or csv, lines, a codec of your own) or mark it #[carbon::skip]");
        return null;
    }

    /**
     * The qualified codec type: inside the model's namespace, or as written. The namespace comes
     * first, the way Echo resolves the name in the model's own file.
     */
    private const function codec(const string& $text, const string& $space) : string?
    {
        if ($text->size() == 0) {
            return null;
        }
        string $inside = "{$space}::{$text}";
        if ($space->size() > 0 && $this->declared->has($inside)) {
            string? $found = $inside;
            return $found;
        }
        if ($this->declared->has($text)) {
            string? $found = $text;
            return $found;
        }
        return null;
    }

    /**
     * The `Raw` of the `carbon::Codec<T, Raw>` that `$via` conforms to for `$field`, or empty.
     */
    private const function raw(const string& $via, const string& $field) : string
    {
        json::Value $d = $this->declared->get($via);
        foreach (Json::items($d, 'conforms') as const &$c) {
            if (Json::text($c, 'name') != 'carbon::Codec') {
                continue;
            }
            array<json::Value> $args = Json::items($c, 'args');
            if ($args->count() != 2 || Types::render($args[0]) != $field) {
                continue;
            }
            string $raw = Types::render($args[1]);
            if (Kinds::plain($raw)) {
                return $raw;
            }
        }
        return '';
    }

    /**
     * Note the field's timestamp role, checking its type.
     */
    private function stamps(const json::Value& $f, const Column& $c, const string& $at, const string& $what, Model& $model) : void
    {
        bool $time = $c->shape == Shape::plain && $c->base == 'hydrahon::DateTime';
        if (Json::has($f, 'created')) {
            if (!$time) {
                $this->problem("{$at}: {$what}: #[carbon::created] goes on a hydrahon::DateTime field");
            }
            $this->settable('created', $c, $at, $what);
            $model->created[] = $c->property;
        }
        if (Json::has($f, 'updated')) {
            if (!$time) {
                $this->problem("{$at}: {$what}: #[carbon::updated] goes on a hydrahon::DateTime field");
            }
            $this->settable('updated', $c, $at, $what);
            $model->updated[] = $c->property;
        }
        if (Json::has($f, 'deleted')) {
            if (!$time || !$c->nullable) {
                $this->problem("{$at}: {$what}: #[carbon::deleted] goes on a hydrahon::DateTime? field");
            }
            $this->settable('deleted', $c, $at, $what);
            if (Json::has($f, 'created') || Json::has($f, 'updated')) {
                $this->problem("{$at}: {$what}: #[carbon::deleted] does not mix with #[carbon::created] or #[carbon::updated], carbon would trash the row as it writes it");
            }
            if ($model->deleted->size() > 0) {
                $this->problem("{$at}: {$what}: one #[carbon::deleted] per model");
            }
            $model->deleted = $c->property;
        }
    }

    /**
     * Report a timestamp `#[carbon::<$tool>]` on a const field, which carbon could not set.
     */
    private function settable(const string& $tool, const Column& $c, const string& $at, const string& $what) : void
    {
        if ($c->fixed) {
            $this->problem("{$at}: {$what}: #[carbon::{$tool}] cannot go on a const field, carbon sets it");
        }
    }

    /**
     * Every enum column type has a name of its own: no declaration takes it, and no two enums
     * of one namespace's models share their last name.
     */
    private function enumNames() : void
    {
        map<string, string> $taken = [];
        foreach ($this->models as const &$m) {
            foreach ($m->columns as const &$c) {
                if (!$c->typed()) {
                    continue;
                }
                string $name = $m->qualify($c->columnClass());
                if ($this->declared->has($name)) {
                    $this->problem("{$m->qualified}::${$c->property}: the generated {$name} would clash with the declaration of that name");
                    continue;
                }
                if ($taken->has($name) && $taken->get($name) != $c->via) {
                    $other = $taken->get($name);
                    $this->problem("{$m->qualified}::${$c->property}: {$c->via} and {$other} would both get the column type {$name}");
                    continue;
                }
                $taken[$name] = $c->via;
            }
        }
    }

    /**
     * Check every relation against the model it points to, once all models are read.
     */
    private function relate() : void
    {
        // every relation class written so far, by qualified name, and the relation it is for
        map<string, string> $written = [];
        foreach ($this->models as const &$self) {
            foreach ($self->relations as const &$r) {
                string $what = "{$self->qualified}::${$r->property}";
                Model $target = guard $this->model($r->target) else {
                    $this->problem("{$what}: {$r->target} is not a model");
                    continue;
                }
                if ($target->bare) {
                    $this->problem("{$what}: {$r->target} is a #[carbon::table], which has no models to load");
                    continue;
                }
                string $class = $self->relationClass($r);
                bool $clash = false;
                foreach ($this->models as const &$other) {
                    if ($other->space() == $self->space() && (Names::local($other->qualified) == $class || $other->handle() == $class)) {
                        $this->problem("{$what}: its generated class {$class} has the name of {$other->qualified} or its table; rename the relation");
                        $clash = true;
                    }
                }
                string $qualifiedClass = $self->qualify($class);
                if (!$clash && $this->declared->has($qualifiedClass)) {
                    $this->problem("{$what}: its generated class {$class} would clash with the declaration of {$qualifiedClass}; rename the relation");
                } else if ($written->has($qualifiedClass)) {
                    $other = $written->get($qualifiedClass);
                    $this->problem("{$what}: its generated class {$class} is the one of {$other} too; rename one of them");
                } else {
                    $written[$qualifiedClass] = $what;
                }
                if ($r->direction == Direction::belongsTo) {
                    // the key lives here and names the target's key
                    Column $fk = guard $self->column($r->foreign) else {
                        $this->problem("{$what}: #[carbon::belongsTo] names {$r->foreign}, which is no column of {$self->qualified}");
                        continue;
                    }
                    if ($fk->shape != Shape::plain || $fk->base != $target->key()->base) {
                        $this->problem("{$what}: {$r->foreign} has to be {$target->key()->base} like the key of {$target->qualified}");
                    }
                } else {
                    // the key lives on the target and names this model's key; a nullable one leaves
                    // the related rows without it out
                    Column $fk = guard $target->column($r->foreign) else {
                        $this->problem("{$what}: names {$r->foreign}, which is no column of {$target->qualified}");
                        continue;
                    }
                    if ($fk->shape != Shape::plain || $fk->base != $self->key()->base) {
                        $this->problem("{$what}: {$target->qualified}::${$r->foreign} has to be {$self->key()->base} like the key of {$self->qualified}");
                    }
                }
            }
        }
    }

    private function defaulted(bool $defaulted, const string& $at, const string& $what) : void
    {
        if (!$defaulted) {
            $this->problem("{$at}: {$what}: carbon only fills columns, so this field needs a default");
        }
    }

    private function problem(const string& $text) : void
    {
        $this->problems[] = $text;
    }

    /**
     * Report every #[carbon::x] on `$v` whose name is not in `$allowed`.
     */
    private function known(const json::Value& $v, const array<string>& $allowed, const string& $at, const string& $what) : void
    {
        foreach (Json::tools($v) as const &$t) {
            string $name = Json::text($t, 'name');
            if (!Schema::listed($allowed, $name)) {
                $this->problem("{$at}: {$what}: unknown attribute #[carbon::{$name}]");
            }
        }
    }

    /**
     * Report every attribute of `$tools` on `$v` that is not in `$kept`: one that does nothing
     * `$where` the field is. Unknown attributes are left to `known`.
     */
    private function idle(const json::Value& $v, const array<string>& $tools, const array<string>& $kept, const string& $where, const string& $at, const string& $what) : void
    {
        foreach (Json::tools($v) as const &$t) {
            string $name = Json::text($t, 'name');
            if (Schema::listed($tools, $name) && !Schema::listed($kept, $name)) {
                $this->problem("{$at}: {$what}: #[carbon::{$name}] does nothing {$where}");
            }
        }
    }

    private static function listed(const array<string>& $names, const string& $name) : bool
    {
        foreach ($names as const &$n) {
            if ($n == $name) {
                return true;
            }
        }
        return false;
    }

    private static function where(const json::Value& $d, int64 $line) : string
    {
        string $file = Json::text($d, 'file');
        return "{$file}:{$line}";
    }
}
