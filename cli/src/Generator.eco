/**
 * The pipeline `carbongen` runs in a module directory: the decls pass, the
 * checks, the file.
 *
 * The decls pass defines CARBON_NOGEN, which the module's manifest uses to
 * leave `.carbon/` out, so a stale generated file can never stop the next
 * one from being written. Code that uses the generated tables fails to
 * compile in that pass; echoc still prints every declaration, so its
 * complaints are kept back unless the pass printed nothing usable.
 */

namespace carbongen;

use std::io;

public class Generator
{
    public string $echoc = 'echoc';

    /**
     * A file holding `echoc -p decls --decls-all` output to read instead of running a decls pass
     * of its own: how a build tool that already made one pass for several generators hands it
     * over. Empty runs the pass.
     */
    public string $from = '';
    // the manifest check, the wiring hint and the messages spell out `.carbon/` as well
    public const string $target = '.carbon/models.eco';
    public bool $quiet = false;

    /**
     * Read the module and render the generated file, or say why not.
     */
    public function render() : result<string, Failure>
    {
        string $manifest = Sys::read('module.eco');
        if ($manifest->empty()) {
            return .error(.input('no module.eco here; run carbongen in the module that declares the models'));
        }
        if (!Generator::wired($manifest)) {
            return .error(.input(Generator::wiring()));
        }
        json::Value $decls = guard $this->decls($manifest) else ($e) {
            return .error($e);
        }
        Schema $schema = Schema::read($decls);
        if ($schema->problems->count() > 0) {
            foreach ($schema->problems as const &$p) {
                io::eprintln("error: {$p}");
            }
            return .error(.problems($schema->problems->count() as int32));
        }
        $this->say("carbongen  {$schema->models->count()} model(s), {$schema->migrations->count()} migration(s)");
        return .ok(Emitter($schema)->render());
    }

    /**
     * Write the generated file. Unchanged content is left alone, so echoc's
     * cache stays warm.
     */
    public function generate() : status<Failure>
    {
        string $text = guard $this->render() else ($e) {
            return .error($e);
        }
        result<bool, io::ioerror> $made = std::fs::mkdir('.carbon');
        if ($made->failed() && $made->failure()->exists() == false) {
            return .error(.input('could not create .carbon/'));
        }
        if (Sys::put($this->target, $text) == false) {
            return .error(.input("could not write {$this->target}"));
        }
        $this->say("wrote      {$this->target}");
        return .ok;
    }

    /**
     * Whether the generated file is what generating would write now.
     */
    public function check() : status<Failure>
    {
        string $text = guard $this->render() else ($e) {
            return .error($e);
        }
        if (Sys::read($this->target) != $text) {
            return .error(.stale);
        }
        $this->say("current    {$this->target}");
        return .ok;
    }

    private function decls(const string& $manifest) : result<json::Value, Failure>
    {
        if (!$this->from->empty()) {
            return $this->read($manifest);
        }
        // a hook calling back into echoc would run itself again without --no-hooks
        array<string> $args = ['build', '-p', 'decls', '--no-hooks', '--define', 'CARBON_NOGEN', '-o', 'ecobuild/carbongen-decls'];
        std::process::output $run = guard std::process::command($this->echoc, $args)->output() else ($e) {
            return .error(.input("could not run {$this->echoc}: {$e->message()}; pass --echoc <path> or set $ECHOC"));
        }
        json::Value $decls = guard json::parse($run->stdout) else {
            return .error(.tool("{$run->status}", $run->stderr));
        }
        if (Json::items($decls, 'modules')->count() == 0) {
            return .error(.tool("{$run->status}", $run->stderr));
        }
        return Generator::checked($decls, $this->echoc);
    }

    /**
     * The declarations of this module out of the file `--decls` names, which holds every
     * module of the program: the ones of the dependencies are not this module's to generate.
     */
    private function read(const string& $manifest) : result<json::Value, Failure>
    {
        string $text = Sys::read($this->from);
        if ($text->empty()) {
            return .error(.input("could not read {$this->from}"));
        }
        json::Value $all = guard json::parse($text) else {
            return .error(.input("{$this->from} is not the JSON echoc -p decls prints"));
        }
        string $name = guard Generator::named($manifest) else {
            return .error(.input('module.eco names no module (#[module: "..."])'));
        }
        json::Value? $local = Generator::only($all, $name);
        if ($local == null) {
            return .error(.input("{$this->from} holds no declarations of module {$name}"));
        }
        json::Value $decls = guard $local;
        return Generator::checked($decls, $this->from);
    }

    private static function checked(json::Value $decls, const string& $origin) : result<json::Value, Failure>
    {
        string? $moved = Generator::unread($decls);
        if ($moved != null) {
            string $key = guard $moved;
            return .error(.input("{$origin}: echoc -p decls no longer gives declarations a '{$key}'; this carbongen reads the format of echoc 0.11, so update one or the other"));
        }
        return .ok($decls);
    }

    /**
     * The name `#[module: "..."]` gives in `$manifest`, null when it gives none.
     */
    public static function named(const string& $manifest) : string?
    {
        foreach (str::split($manifest, "\n") as const &$raw) {
            string $line = string::from(str::trim($raw));
            if (!$line->starts('#[module:')) {
                continue;
            }
            // either quote: the manifest is Echo
            string $quote = '"';
            usize $open = $line->find($quote);
            usize $single = $line->find("'");
            if ($single < $open) {
                $open = $single;
                $quote = "'";
            }
            if ($open == $line->size()) {
                return null;
            }
            string $rest = $line->sub($open + 1, $line->size() - $open - 1);
            usize $close = $rest->find($quote);
            if ($close == $rest->size()) {
                return null;
            }
            string? $name = $rest->sub(0, $close);
            return $name;
        }
        return null;
    }

    /**
     * `$decls` cut down to the module called `$name`, in the shape a pass without
     * `--decls-all` prints; null when no module has that name.
     */
    public static function only(const json::Value& $decls, const string& $name) : json::Value?
    {
        foreach (Json::items($decls, 'modules') as const &$m) {
            if (Json::text($m, 'name') != $name) {
                continue;
            }
            json::Value $list = json::arr();
            $list[] = $m;
            json::Value $out = json::object();
            $out['modules'] = $list;
            json::Value? $found = $out;
            return $found;
        }
        return null;
    }

    /**
     * The first key carbongen reads off a declaration that the decls output does not have, null
     * when it has every one. echoc does not version the format; this is how a change to it
     * shows up as a message instead of models that quietly lose their columns.
     */
    public static function unread(const json::Value& $decls) : string?
    {
        array<string> $keys = ['kind', 'qualified', 'file', 'line', 'tools', 'conforms', 'fields'];
        foreach (Json::items($decls, 'modules') as const &$m) {
            array<json::Value> $found = Json::items($m, 'declarations');
            if ($found->count() == 0) {
                continue;
            }
            // one declaration tells: echoc writes every one in the same shape
            json::Value $d = $found[0];
            foreach ($keys as const &$k) {
                json::Value? $has = $d->get($k);
                if ($has == null) {
                    return $k;
                }
            }
            return null;
        }
        return null;
    }

    /**
     * Whether `$manifest` leaves `.carbon/` out behind CARBON_NOGEN: a `#[sources: ".carbon/…"]`
     * line inside an `#[if: !CARBON_NOGEN]` block. Comments do not count.
     */
    public static function wired(const string& $manifest) : bool
    {
        bool $inside = false;
        foreach (str::split($manifest, "\n") as const &$raw) {
            string $line = string::from(str::trim($raw));
            if ($line->starts('//') || $line->starts('*') || $line->starts('/*')) {
                continue;
            }
            if ($line->starts('#[if:') && $line->contains('!CARBON_NOGEN')) {
                $inside = true;
                continue;
            }
            if ($line->starts('#[end]')) {
                $inside = false;
                continue;
            }
            if ($inside && $line->starts('#[sources:') && $line->contains('.carbon/')) {
                return true;
            }
        }
        return false;
    }

    private function say(const string& $text) : void
    {
        if ($this->quiet == false) {
            io::println($text);
        }
    }

    private static function wiring() : string
    {
        string $out = "module.eco does not include .carbon/ behind CARBON_NOGEN. add:\n\n";
        $out->append("#[if: !CARBON_NOGEN]\n");
        $out->append("#[sources: \".carbon/*.eco\"]\n");
        $out->append('#[end]');
        return $out;
    }
}
