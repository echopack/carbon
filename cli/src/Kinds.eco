namespace carbongen;

/**
 * The value kinds carbon can store, and how a cursor reads each.
 */
public struct Kinds
{
    /**
     * The cursor method for a base term type.
     */
    public static function reader(const string& $base) : string
    {
        if ($base == 'int64') {
            return 'int';
        }
        if ($base == 'uint64') {
            return 'uint';
        }
        if ($base == 'float64') {
            return 'float';
        }
        if ($base == 'string') {
            return 'text';
        }
        if ($base == 'hydrahon::Decimal') {
            return 'decimal';
        }
        if ($base == 'hydrahon::Bytes') {
            return 'bytes';
        }
        if ($base == 'hydrahon::Date') {
            return 'date';
        }
        if ($base == 'hydrahon::DateTime') {
            return 'datetime';
        }
        if ($base == 'hydrahon::Time') {
            return 'time';
        }
        return 'bool';
    }

    /**
     * Whether `$name` is stored as it is.
     */
    public static function plain(const string& $name) : bool
    {
        array<string> $kinds = ['int64', 'uint64', 'float64', 'bool', 'string', 'hydrahon::Decimal', 'hydrahon::Bytes', 'hydrahon::Date', 'hydrahon::DateTime', 'hydrahon::Time'];
        foreach ($kinds as const &$k) {
            if ($k == $name) {
                return true;
            }
        }
        return false;
    }

    /**
     * The stored type of a narrower number, or empty when `$name` is none.
     */
    public static function widened(const string& $name) : string
    {
        if ($name == 'int8' || $name == 'int16' || $name == 'int32' || $name == 'uint8' || $name == 'uint16' || $name == 'uint32') {
            return 'int64';
        }
        if ($name == 'float32') {
            return 'float64';
        }
        return '';
    }

    /**
     * The smallest and largest value of an integer type, as Echo source, or empty for 64 bit
     * and non-integer types.
     */
    public static function bounds(const string& $name) : array<string>
    {
        if ($name == 'int8') {
            return ['-128', '127'];
        }
        if ($name == 'int16') {
            return ['-32768', '32767'];
        }
        if ($name == 'int32') {
            return ['-2147483648', '2147483647'];
        }
        if ($name == 'uint8') {
            return ['0', '255'];
        }
        if ($name == 'uint16') {
            return ['0', '65535'];
        }
        if ($name == 'uint32') {
            return ['0', '4294967295'];
        }
        array<string> $none = [];
        return $none;
    }
}
